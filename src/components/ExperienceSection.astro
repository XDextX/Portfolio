---
import ExperienceCard from './ExperienceCard.astro';
import { EXPERIENCES } from '../data/experience';
import { ABOUT } from '../data/about';
import SectionTitle from './SectionTitle.astro';
import { SECTION_TITLES } from '../data/sectionTitles';
import { t } from '@i18n/index';

export interface Props {
	locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const titleId = SECTION_TITLES.experience.id;
const last = EXPERIENCES.length - 1;
// Spec 013: a dot per job and a rail segment from each dot to the next, real spans so
// RF-1 can measure them; the CV link opens the hero's file in this tab (D-3).
---

<section class='section' id='Experience' aria-labelledby={titleId}>
	<SectionTitle section='experience' />

	<ul class='exp-list'>
		{EXPERIENCES.map((e, i) => (
			<li class='exp-item'>
				<span class='exp-dot' aria-hidden='true'></span>
				{i < last && <span class='exp-rail' aria-hidden='true'></span>}
				<ExperienceCard
					role={e.role[locale]}
					company={e.company}
					period={e.period[locale]}
					location={e.location?.[locale]}
					bullets={e.bullets[locale]}
					glyph={e.glyph}
					tech={e.tech}
				/>
			</li>
		))}
	</ul>

	<p class='exp-more'><a class='exp-cv' href={ABOUT.resumeUrl}>{t('experience.cv')}</a></p>
</section>

<style>
	/* Every derived value reads these. --dot-y lands the dot on the card's first line:
	   1.25rem is .card-frame's padding, 0.25rem centres it on that line. */
	.exp-list {
		--dot: 0.75rem;
		--rail-col: 2rem;
		--period-col: 7rem;
		--gap: 1rem;
		--dot-y: calc(1.25rem + 0.25rem);
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--gap);
	}

	.exp-item {
		position: relative;
		padding-inline-start: var(--rail-col);
	}

	.exp-dot {
		position: absolute;
		inset-inline-start: calc((var(--rail-col) - var(--dot)) / 2);
		top: var(--dot-y);
		inline-size: var(--dot);
		block-size: var(--dot);
		border-radius: 50%;
		background: var(--accent-text);
		z-index: 1;
	}

	/* Every dot sits at the same offset in its item, so a segment one item plus one gap
	   tall ends exactly on the next dot's centre; the dot paints over it (z-index).
	   Dotted in --neutral-400: --color-border measured 1.27:1 light, 1.54 dark. */
	.exp-rail {
		position: absolute;
		inset-inline-start: calc(var(--rail-col) / 2 - 1px);
		z-index: 0;
		top: calc(var(--dot-y) + var(--dot) / 2);
		block-size: calc(100% + var(--gap));
		border-inline-start: 2px dotted var(--neutral-400);
	}

	/* From 40rem the period leaves the card for its own column, between the rail and
	   the card, as in the proposal (spec 027). It anchors to the card, which is
	   positioned, so the offset is measured back from the card's own start. */
	@media (min-width: 40rem) {
		.exp-item {
			padding-inline-start: calc(var(--rail-col) + var(--period-col));
		}

		.exp-item :global(.exp-period) {
			position: absolute;
			inset-inline-end: calc(100% + var(--gap));
			inline-size: calc(var(--period-col) - var(--gap));
			top: 1.25rem;
			text-align: start;
		}
	}

	.exp-more {
		margin: var(--sp-4) 0 0;
	}

	.exp-cv {
		color: var(--accent-text);
		font-weight: 600;
		text-decoration: underline;
	}

	/* Spec 048: a 44px target under a finger, the text as it is. */
	@media (pointer: coarse) {
		.exp-cv {
			display: inline-flex;
			align-items: center;
			min-block-size: 44px;
			min-inline-size: 44px;
		}
	}
</style>
