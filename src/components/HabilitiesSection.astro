---
import { TECH } from '../data/tech';
import TechGrid from './TechGrid.astro';
import SectionTitle from './SectionTitle.astro';
import { SECTION_TITLES } from '../data/sectionTitles';

export interface Props {
	locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const titleId = SECTION_TITLES.skills.id;
---

<section class='section' id='skills' aria-labelledby={titleId}>
	<SectionTitle section='skills' />
	<TechGrid items={TECH} locale={locale} />
</section>
