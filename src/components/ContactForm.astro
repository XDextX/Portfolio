---
import { t } from '@i18n/index';
import { FIELD_LIMITS, type Field } from '../pages/lib/contact';

/**
 * Spec 015: the contact form. Posts to the page without scripts (index.astro runs the handler
 * into Astro.locals.contact) and to /api/contact with them; both answer through one handler.
 */
interface Props {}

const state = Astro.locals.contact;
const FIELDS = Object.keys(FIELD_LIMITS) as Field[];
const LABEL_KEYS: Record<Field, string> = {
	name: 'contact.form.name',
	email: 'about.social.email',
	subject: 'contact.form.subject',
	message: 'contact.form.message',
};
const TYPES: Partial<Record<Field, string>> = { email: 'email' };
const AUTOCOMPLETE: Partial<Record<Field, string>> = { name: 'name', email: 'email' };
const bad = (f: Field) => !!state?.fields.includes(f);
const value = (f: Field) => state?.values?.[f] ?? '';
---

<div class='contact-form-card card-frame'>
<form method='post' action='#Contact' class='contact-form' data-contact-form>
	{
		FIELDS.map((f) => (
			<div class:list={['contact-form__field', { 'contact-form__field--half': f === 'name' || f === 'email' }]}>
				<label class='contact-form__label'>
					<span>{t(LABEL_KEYS[f])}</span>
					{f === 'message' ? (
						<textarea
							class='contact-form__control contact-form__control--area'
							name={f}
							rows='4'
							required
							maxlength={FIELD_LIMITS[f]}
							aria-invalid={bad(f) ? 'true' : undefined}
							aria-describedby={bad(f) ? `contact-err-${f}` : undefined}
						>{value(f)}</textarea>
					) : (
						<input
							class='contact-form__control'
							name={f}
							type={TYPES[f] ?? 'text'}
							autocomplete={AUTOCOMPLETE[f]}
							required
							maxlength={FIELD_LIMITS[f]}
							value={value(f)}
							aria-invalid={bad(f) ? 'true' : undefined}
							aria-describedby={bad(f) ? `contact-err-${f}` : undefined}
						/>
					)}
				</label>
				<p class='contact-form__error' id={`contact-err-${f}`} data-error-for={f} hidden={!bad(f)}>
					{t(`contact.form.errors.${f}`)}
				</p>
			</div>
		))
	}
	<div class='contact-form__trap' aria-hidden='true'>
		<label>
			{t('contact.form.trap')}
			<input name='website' type='text' tabindex='-1' autocomplete='off' />
		</label>
	</div>
	<button type='submit' class='btn btn--primary contact-form__submit'>
		<span class='contact-form__icon' aria-hidden='true'></span>
		{t('contact.form.submit')}
	</button>
	<p class='contact-form__privacy' data-contact-privacy>{t('contact.form.privacy')}</p>
	<p
		class='contact-form__status'
		role='status'
		aria-live='polite'
		data-contact-status
		data-sent={t('contact.form.outcome.sent')}
		data-invalid={t('contact.form.outcome.invalid')}
		data-limited={t('contact.form.outcome.limited')}
		data-failed={t('contact.form.outcome.failed')}
	>
		{state ? t(`contact.form.outcome.${state.outcome}`) : ''}
	</p>
</form>
</div>

<script>
	type Outcome = 'sent' | 'invalid' | 'limited' | 'failed';
	const OUTCOMES: Outcome[] = ['sent', 'invalid', 'limited', 'failed'];

	function enhance(form: HTMLFormElement) {
		if (form.dataset.enhanced) return;
		form.dataset.enhanced = '1';
		const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
		let pending = false;
		form.addEventListener('submit', async (ev) => {
			ev.preventDefault();
			if (pending) return;
			pending = true;
			form.setAttribute('aria-busy', 'true');
			try {
				let outcome: Outcome = 'failed';
				let fields: string[] = [];
				try {
					const res = await fetch('/api/contact', {
						method: 'POST',
						body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
					});
					const body = await res.json();
					if (OUTCOMES.includes(body.outcome)) { outcome = body.outcome; fields = body.fields ?? []; }
				} catch { /* network or parse failure reads as failed */ }
				// Navigated away while waiting: the answer belongs to a form nobody sees.
				if (!form.isConnected) return;
				let first: HTMLElement | null = null;
				for (const err of form.querySelectorAll<HTMLElement>('[data-error-for]')) {
					const f = err.dataset.errorFor!;
					const control = form.elements.namedItem(f) as HTMLInputElement | null;
					const invalid = fields.includes(f);
					err.hidden = !invalid;
					if (!control) continue;
					if (invalid) {
						control.setAttribute('aria-invalid', 'true');
						control.setAttribute('aria-describedby', err.id);
						first ??= control;
					} else {
						control.removeAttribute('aria-invalid');
						control.removeAttribute('aria-describedby');
					}
				}
				if (outcome === 'sent') form.reset();
				// Cleared first so a repeated outcome is announced again.
				status.textContent = '';
				requestAnimationFrame(() => { status.textContent = status.dataset[outcome] ?? ''; });
				if (outcome === 'invalid') first?.focus();
			} finally {
				pending = false;
				form.removeAttribute('aria-busy');
			}
		});
	}

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach(enhance);
	});
</script>

<style>
	/* The form in its own card, as the proposal draws it (spec 029); a container, so the
	   form's own width decides when Name and Email share a row. */
	.contact-form-card {
		container: form / inline-size;
	}

	.contact-form {
		display: grid;
		gap: var(--sp-3);
	}

	@container form (min-width: 20rem) {
		.contact-form {
			grid-template-columns: 1fr 1fr;
		}

		.contact-form > :not(.contact-form__field--half) {
			grid-column: 1 / -1;
		}
	}

	/* The label is the field's box: its name small at the top, always visible while the
	   field holds text (spec 029, owner's choice over a placeholder). The box rests in the
	   control border and turns gold on hover; the input inside keeps its own focus ring. */
	.contact-form__label {
		display: grid;
		gap: 0.1rem;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--control-border);
		border-radius: var(--radius-sm);
		background: var(--card-background);
		transition: border-color 0.15s ease;
	}

	.contact-form__label:hover {
		border-color: var(--accent-text);
	}

	.contact-form__label:has([aria-invalid='true']) {
		border: 2px solid var(--fg);
	}

	.contact-form__label > span {
		font-size: var(--fs-xs);
		font-weight: 600;
		color: var(--text-secondary);
	}

	/* Name and Email sit side by side, so their boxes state the height (AGENTS). */
	.contact-form__field--half .contact-form__label {
		box-sizing: border-box;
		block-size: 3.6rem;
	}

	.contact-form__control {
		box-sizing: border-box;
		inline-size: 100%;
		padding: 0;
		font: inherit;
		font-weight: 400;
		color: var(--text-color);
		background: transparent;
		border: 0;
	}

	.contact-form__control--area {
		resize: vertical;
		min-block-size: 5rem;
	}

	.contact-form__error {
		margin: var(--sp-2) 0 0;
		font-size: var(--fs-sm);
		font-weight: 600;
		color: var(--danger-color);
	}

	.contact-form__error[hidden] {
		display: none;
	}

	/* Off screen rather than display: none, which some bots read as "skip this field"; unpainted
	   so no unthemed control counts as sitting on a glow (spec 009 RF-6 measured it at 2.81:1). */
	.contact-form__trap {
		position: absolute;
		visibility: hidden;
		left: -10000px;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
	}

	/* .btn transitions every property, the outline included: on Tab the ring started at its
	   initial 3px in the navy ink and read 1.00:1 on the dark glow (spec 009 RF-6). */
	.contact-form__submit {
		justify-self: stretch;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		transition-property: transform, box-shadow, background-color, border-color, color;
	}

	/* Nothing lifts on hover (AGENTS): the base .btn lift, on a full-width button, moved it
	   1px out from under a resting pointer and back, so it never held still for a click. */
	.contact-form__submit:hover {
		transform: none;
	}

	/* The proposal's paper plane, a mask in the button's own ink. */
	.contact-form__icon {
		inline-size: 1rem;
		block-size: 1rem;
		background-color: currentColor;
		mask: url(/icons/ui/send.svg) center / contain no-repeat;
		-webkit-mask: url(/icons/ui/send.svg) center / contain no-repeat;
	}

	.contact-form__privacy {
		margin: 0;
		font-size: var(--fs-sm);
		color: var(--neutral-600);
	}

	.contact-form__status {
		margin: 0;
		font-weight: 600;
		color: var(--text-color);
	}
</style>
