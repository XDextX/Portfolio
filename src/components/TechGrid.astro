---
import SkillBar from './SkillBar.astro';
import SkillChip from './SkillChip.astro';
import SkillViewToggle from './SkillViewToggle.astro';
import { type TechLevel } from '../data/levelLabels';
import { t } from '@i18n/index';

/**
 * Skills grid with a bars view and a compact list view.
 * @param items tech entries grouped by their data category.
 * @param locale active locale for the row badges.
 */

export interface TechItem {
	name: string;
	logo: string;
	icon: string;
	brand?: string;
	href?: string;
	level?: TechLevel;
	category?: string;
}

export interface Props {
	items: TechItem[];
	locale?: 'es' | 'en';
}

const { items, locale = 'es' } = Astro.props;

function groupBy<T>(arr: T[], key: (item: T) => string): [string, T[]][] {
	const map = new Map<string, T[]>();
	for (const item of arr) {
		const bucket = map.get(key(item)) ?? [];
		bucket.push(item);
		map.set(key(item), bucket);
	}
	return Array.from(map.entries());
}

const byCategory = groupBy(items, (t) => t.category ?? 'Other');

// The data value is the lookup only: `Frontend` reads `skills.areas.frontend`,
// so no area name is spelled as visitor text in the bars panel.

// The area card is the shared frame and nothing else. No hover: it groups rows,
// it is not itself a control.
const areaKey = (category: string) => `skills.areas.${category.toLowerCase()}`;
---

<div class='tech-grid'>
	<div class='grid-toolbar'>
		<SkillViewToggle />
	</div>

	<!-- BARS -->
	<div data-panel='bars' class='panel'>
		<div class='bars-grid'>
			{
				byCategory.map(([cat, techs]) => (
					<div class='card-frame'>
						<h4 class='cat-label'>{t(areaKey(cat))}</h4>
						<ul class='bars-list'>
							{techs.map((tech) => (
								<SkillBar
									name={tech.name}
									icon={tech.icon}
									brand={tech.brand}
									level={(tech.level ?? 'beginner') as TechLevel}
									locale={locale}
								/>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>

	<!-- LIST -->
	<div data-panel='list' class='panel hidden'>
		<div class='chip-grid'>
			{
				byCategory.map(([cat, techs]) => (
					<div class='cat-group'>
						<h4 class='cat-label'>{cat}</h4>
						<ul class='chip-list'>
							{techs.map((tech) => (
								<li>
									<SkillChip
										name={tech.name}
										logo={tech.logo}
										href={tech.href}
										level={(tech.level ?? 'beginner') as TechLevel}
										locale={locale}
									/>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	const STORAGE_KEY = 'skills-view';

	function activate(root: Element, view: string) {
		root.querySelectorAll('[data-panel]').forEach((p) => {
			(p as HTMLElement).classList.toggle(
				'hidden',
				(p as HTMLElement).dataset.panel !== view,
			);
		});
		root.querySelectorAll('[data-view]').forEach((b) => {
			const active = (b as HTMLElement).dataset.view === view;
			b.setAttribute('aria-pressed', String(active));
			b.classList.toggle('active', active);
		});
		localStorage.setItem(STORAGE_KEY, view);

		if (view === 'bars') {
			root.querySelectorAll('.bar-track').forEach((el) => {
				el.classList.remove('animated');
				void (el as HTMLElement).offsetWidth;
				el.classList.add('animated');
			});
		}
	}

	document.addEventListener('astro:page-load', () => {
		const root = document.querySelector('.tech-grid');
		if (!root) return;

		activate(root, localStorage.getItem(STORAGE_KEY) ?? 'bars');

		root
			.querySelectorAll('[data-view]')
			.forEach((btn) =>
				btn.addEventListener('click', () =>
					activate(root, (btn as HTMLElement).dataset.view ?? 'bars'),
				),
			);
	});
</script>

<style>
	.tech-grid {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.grid-toolbar {
		display: flex;
		justify-content: flex-end;
	}

	/* Bars need real width: SkillBar spends ~260px on logo, name and level tag
	   before the track starts, so 2 columns squeezed it to 31px, and to 0px below
	   ~546px of content. auto-fit only splits once each column clears 420px. */
	.chip-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--sp-3) var(--sp-6);
	}

	/* As many area cards per line as each still holds one minimum row: the
	   .bars-list minimum below plus .card-frame's padding and border (spec 006
	   RF-10). 3 per line at 1280px and 1024px, 2 at 800px, 1 at 390px. */
	.bars-grid {
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(calc(22px + 0.6rem + 60px + 0.6rem + 7rem + 1.25rem + 1.25rem + 1px + 1px), 100%), 1fr)
		);
		gap: var(--sp-3) var(--sp-6);
	}

	.cat-group {
		margin-bottom: var(--sp-2);
	}

	/* The data already spells the category the way it should read — "Frontend",
	   not "FRONTEND" — so uppercasing plus 0.06em of tracking was shouting a
	   correct word. Hierarchy is carried by size: h2 --fs-xl, category --fs-base,
	   items --fs-sm. .contact-label keeps uppercase because "Email" in sentence
	   case reads as the common noun. */
	.cat-label {
		font-size: var(--fs-base);
		font-weight: 600;
		color: var(--text-secondary);
		margin: 0 0 var(--sp-3) 0;
	}

	.panel.hidden {
		display: none;
	}

	/* Two rows share a line when both keep the row's own minimum: SkillBar's
	   icon, gap, track floor, gap and badge maximum, summed (spec 006 RF-9).
	   auto-fill keeps a lone row at half width, so every bar has one length. */
	.bars-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(calc(22px + 0.6rem + 60px + 0.6rem + 7rem), 100%), 1fr)
		);
		gap: var(--sp-2) var(--sp-4);
	}

	.chip-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
	}

	@media (max-width: 600px) {
		.chip-grid {
			grid-template-columns: 1fr;
		}
		/* .bars-grid needs no rule: auto-fit already drops to one column. */
	}
</style>
