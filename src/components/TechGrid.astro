---
import SkillBar from './SkillBar.astro';
import SkillChip from './SkillChip.astro';
import SkillViewToggle from './SkillViewToggle.astro';
import AreaHeading from './AreaHeading.astro';
import { type TechLevel } from '../data/levelLabels';
import { SKILL_AREAS, populatedAreas, type TechEntry } from '../data/tech';

/**
 * Skills grid with a bars view and a compact list view.
 * @param items tech entries, grouped under the declared areas they name.
 * @param locale active locale for the row badges.
 */
export interface Props {
	items: TechEntry[];
	locale?: 'es' | 'en';
}

const { items, locale = 'es' } = Astro.props;

// Spec 012: areas render in SKILL_AREAS order, an empty one not at all. The key is
// the lookup only, so no heading is spelled here. The card groups rows; no hover.
const areas = populatedAreas(SKILL_AREAS, items);
---

<div class='tech-grid'>
	<div class='grid-toolbar'>
		<SkillViewToggle />
	</div>

	<!-- BARS -->
	<div data-panel='bars' class='panel'>
		<div class='bars-grid'>
			{
				areas.map((area) => (
					<div class='card-frame'>
						<AreaHeading area={area} />
						<ul class='bars-list'>
							{area.items.map((tech) => (
								<SkillBar
									name={tech.name}
									logo={tech.logo}
									level={(tech.level ?? 'beginner') as TechLevel}
									locale={locale}
								/>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>

	<!-- LIST -->
	<div data-panel='list' class='panel hidden'>
		<div class='chip-grid'>
			{
				areas.map((area) => (
					<div class='cat-group'>
						<AreaHeading area={area} />
						<ul class='chip-list'>
							{area.items.map((tech) => (
								<li>
									<SkillChip
										name={tech.name}
										logo={tech.logo}
										href={tech.href}
										level={(tech.level ?? 'beginner') as TechLevel}
										locale={locale}
									/>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	const STORAGE_KEY = 'skills-view';

	function activate(root: Element, view: string) {
		root.querySelectorAll('[data-panel]').forEach((p) => {
			(p as HTMLElement).classList.toggle(
				'hidden',
				(p as HTMLElement).dataset.panel !== view,
			);
		});
		root.querySelectorAll('[data-view]').forEach((b) => {
			const active = (b as HTMLElement).dataset.view === view;
			b.setAttribute('aria-pressed', String(active));
		});
		localStorage.setItem(STORAGE_KEY, view);

		if (view === 'bars') {
			root.querySelectorAll('.bar-track').forEach((el) => {
				el.classList.remove('animated');
				void (el as HTMLElement).offsetWidth;
				el.classList.add('animated');
			});
		}
	}

	document.addEventListener('astro:page-load', () => {
		const root = document.querySelector('.tech-grid');
		if (!root) return;

		activate(root, localStorage.getItem(STORAGE_KEY) ?? 'bars');

		root
			.querySelectorAll('[data-view]')
			.forEach((btn) =>
				btn.addEventListener('click', () =>
					activate(root, (btn as HTMLElement).dataset.view ?? 'bars'),
				),
			);
	});
</script>

<style>
	.tech-grid {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.grid-toolbar {
		display: flex;
		justify-content: flex-end;
	}

	/* Bars need real width: SkillBar spends ~260px on logo, name and level tag
	   before the track starts, so 2 columns squeezed it to 31px, and to 0px below
	   ~546px of content. auto-fit only splits once each column clears 420px. */
	.chip-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--sp-3) var(--sp-6);
	}

	/* As many area cards per line as each still holds one minimum row: the
	   .bars-list minimum below plus .card-frame's padding and border (spec 006
	   RF-10). 3 per line at 1280px and 1024px, 2 at 800px, 1 at 390px. */
	.bars-grid {
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(calc(22px + 0.6rem + 60px + 0.6rem + 7rem + 1.25rem + 1.25rem + 1px + 1px), 100%), 1fr)
		);
		gap: var(--sp-3) var(--sp-6);
	}

	.cat-group {
		margin-bottom: var(--sp-2);
	}

	.panel.hidden {
		display: none;
	}

	/* Two rows share a line when both keep the row's own minimum: SkillBar's
	   icon, gap, track floor, gap and badge maximum, summed (spec 006 RF-9).
	   auto-fill keeps a lone row at half width, so every bar has one length. */
	.bars-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(calc(22px + 0.6rem + 60px + 0.6rem + 7rem), 100%), 1fr)
		);
		gap: var(--sp-2) var(--sp-4);
	}

	.chip-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
	}

	@media (max-width: 600px) {
		.chip-grid {
			grid-template-columns: 1fr;
		}
		/* .bars-grid needs no rule: auto-fit already drops to one column. */
	}
</style>
