---
import SkillBar from './SkillBar.astro';
import SkillChip from './SkillChip.astro';
import SkillViewToggle from './SkillViewToggle.astro';
import { type TechLevel } from '../data/levelLabels';

export interface TechItem {
	name: string;
	logo: string;
	href?: string;
	level?: TechLevel;
	category?: string;
}

export interface Props {
	items: TechItem[];
	locale?: 'es' | 'en';
}

const { items, locale = 'es' } = Astro.props;

function groupBy<T>(arr: T[], key: (item: T) => string): [string, T[]][] {
	const map = new Map<string, T[]>();
	for (const item of arr) {
		const bucket = map.get(key(item)) ?? [];
		bucket.push(item);
		map.set(key(item), bucket);
	}
	return Array.from(map.entries());
}

const byCategory = groupBy(items, (t) => t.category ?? 'Other');
---

<div class='tech-grid'>
	<div class='grid-toolbar'>
		<SkillViewToggle />
	</div>

	<!-- BARS -->
	<div data-panel='bars' class='panel'>
		<div class='bars-grid'>
			{
				byCategory.map(([cat, techs]) => (
					<div class='cat-group'>
						<h4 class='cat-label'>{cat}</h4>
						<ul class='bars-list'>
							{techs.map((tech) => (
								<SkillBar
									name={tech.name}
									logo={tech.logo}
									level={(tech.level ?? 'beginner') as TechLevel}
									locale={locale}
								/>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>

	<!-- LIST -->
	<div data-panel='list' class='panel hidden'>
		<div class='chip-grid'>
			{
				byCategory.map(([cat, techs]) => (
					<div class='cat-group'>
						<h4 class='cat-label'>{cat}</h4>
						<ul class='chip-list'>
							{techs.map((tech) => (
								<li>
									<SkillChip
										name={tech.name}
										logo={tech.logo}
										href={tech.href}
										level={(tech.level ?? 'beginner') as TechLevel}
										locale={locale}
									/>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	const STORAGE_KEY = 'skills-view';

	function activate(root: Element, view: string) {
		root.querySelectorAll('[data-panel]').forEach((p) => {
			(p as HTMLElement).classList.toggle(
				'hidden',
				(p as HTMLElement).dataset.panel !== view,
			);
		});
		root.querySelectorAll('[data-view]').forEach((b) => {
			const active = (b as HTMLElement).dataset.view === view;
			b.setAttribute('aria-pressed', String(active));
			b.classList.toggle('active', active);
		});
		localStorage.setItem(STORAGE_KEY, view);

		if (view === 'bars') {
			root.querySelectorAll('.bar-fill').forEach((el) => {
				el.classList.remove('animated');
				void (el as HTMLElement).offsetWidth;
				el.classList.add('animated');
			});
		}
	}

	document.addEventListener('astro:page-load', () => {
		const root = document.querySelector('.tech-grid');
		if (!root) return;

		activate(root, localStorage.getItem(STORAGE_KEY) ?? 'bars');

		root
			.querySelectorAll('[data-view]')
			.forEach((btn) =>
				btn.addEventListener('click', () =>
					activate(root, (btn as HTMLElement).dataset.view ?? 'bars'),
				),
			);
	});
</script>

<style>
	.tech-grid {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.grid-toolbar {
		display: flex;
		justify-content: flex-end;
	}

	/* Chips are small, so two columns always fit comfortably.
	   Bars need real width for the progress track: SkillBar spends ~260px on
	   its logo, name and level tag before the track starts, so a 2-column grid
	   squeezed the track down to 31px (and to 0px below ~546px of content).
	   auto-fit only splits into two once each column clears 420px; below that
	   it stays single-column, which is what keeps the track visible. */
	.chip-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--sp-3) var(--sp-6);
	}

	.bars-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
		gap: var(--sp-3) var(--sp-6);
	}

	.cat-group {
		margin-bottom: var(--sp-2);
	}

	/* The category name is a group heading, and the data already spells it the
	   way it should read — "Frontend", not "FRONTEND". Forcing uppercase and
	   0.06em of tracking on top of that was shouting a word that was already
	   written correctly, and it is the single loudest template tell on the page.

	   Hierarchy here is carried by size, which is the only thing that scales:
	   the section <h2> is --fs-xl, a category is --fs-base, and the items in it
	   are --fs-sm. Nothing else has to shout to be found.

	   .contact-label keeps its uppercase treatment on purpose: it names a channel
	   (Email, GitHub, LinkedIn), and in sentence case "Email" reads as the common
	   noun rather than the name. Same look, different meaning — which is only
	   legible because the two are no longer the same thing. */
	.cat-label {
		font-size: var(--fs-base);
		font-weight: 600;
		color: var(--text-secondary);
		margin: 0 0 var(--sp-3) 0;
	}

	.panel.hidden {
		display: none;
	}

	.bars-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.chip-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
	}

	@media (max-width: 600px) {
		.chip-grid {
			grid-template-columns: 1fr;
		}
		/* .bars-grid needs no rule: auto-fit already drops to one column. */
	}
</style>
