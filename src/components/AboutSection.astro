---
import AvatarCircle from './AvatarCircle.astro';
import HeroBackground from './HeroBackground.astro';
import { ABOUT, JsonLdAbout } from '../data/about';
import { t } from '@i18n/index';

export interface Props {
	lang?: 'es' | 'en';
	withJsonLd?: boolean;
}

const { lang = 'es', withJsonLd = true } = Astro.props;
const personJsonLd = withJsonLd ? JsonLdAbout : null;

// Through t(), not a lang ternary. These were `lang === 'es' ? 'Descargar CV' :
// 'Download CV'`, which puts prose in the component where no translator looks
// and makes a locale switch depend on a second mechanism beside this one.
const cvLabel       = t('about.cv');
const actionsLabel  = t('about.actions');
const locationLabel = t('about.location');
const { given, family } = ABOUT.nameParts;

/*
 * Kept here because Astro emits the template body verbatim. The artwork is an
 * opaque white square, so it sits as a square rather than cropped like a
 * portrait. The middle dot was aria-hidden, so AT read "DeveloperCosta Rica".
 */
---

<section class='section section--hero' id='About' aria-labelledby='about-title'>
	<HeroBackground />
	{personJsonLd && (
		<script type='application/ld+json' set:html={JSON.stringify(personJsonLd)} />
	)}

	<div class='about-grid'>
		<div class='about-avatar'>
			<AvatarCircle
				src={ABOUT.avatar}
				alt={ABOUT.name}
				size='100%'
				shape='square'
			/>
		</div>

		<!-- Content -->
		<div class='about-content'>
			<div class='about-meta'>
				<h1 id='about-title' class='about-name'><span class='about-name__given'>{given}</span>{family && [' ', <span class='about-name__family'>{family}</span>]}</h1>
				<div class='about-sub'>
					<span class='about-job'>{ABOUT.title}</span>
					<span class='about-location' aria-label={locationLabel}>
						<svg xmlns='http://www.w3.org/2000/svg' width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z'/><circle cx='12' cy='10' r='3'/></svg>
						{ABOUT.location}
					</span>
				</div>
			</div>

			<ul class='about-phrases' role='list'>{ABOUT.phraseKeys.map((k) => <li>{t(k)}</li>)}</ul>

			<p class='about-bio'>{ABOUT.bio[lang]}</p>

			<nav class='about-actions' aria-label={actionsLabel}>
				<a
					class='btn-cv'
					href={ABOUT.resumeUrl}
					download
				>
					<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' y1='15' x2='12' y2='3'/></svg>
					{cvLabel}
				</a>

				{ABOUT.socials.map((s) => (
					<a
						class='btn-social'
						href={s.href}
						target='_blank'
						rel='noopener noreferrer me'
					>
						<span class='btn-social__icon' aria-hidden='true' style={`--icon: url(${s.glyph})`}></span>{t(s.labelKey)}
					</a>
				))}
			</nav>
		</div>
	</div>
</section>

<style>
	/* The band draws under the hero's content and over its own glow (spec 036). */
	.section--hero {
		position: relative;
		isolation: isolate;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 160px 1fr;
		align-items: start;
		gap: 2rem;
	}

	/* The avatar in a framed tile, top-aligned with the name, as the proposal draws it (spec 035). */
	.about-avatar {
		width: 160px;
		height: 160px;
		box-sizing: border-box;
		padding: var(--sp-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--card-background);
	}

	/* Content column */
	.about-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.about-meta {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	/* Fluid between the two sizes that work: --fs-4xl measured 623px against a
	   780px column (one line) but needs three at 52px in a 273px phone column,
	   where 40px gives two. Weight was 800, outside the font's 100-700 range. */
	.about-name {
		font-size: clamp(2.5rem, 2rem + 2.2vw, var(--fs-4xl));
		font-weight: 700;
		margin: 0;
		line-height: var(--lh-tight);
		letter-spacing: -0.01em;
	}

	.about-name__given {
		color: var(--text-color);
	}

	.about-name__family {
		color: var(--accent-text);
	}

	.about-sub {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.about-job {
		font-size: var(--fs-base);
		font-weight: 700;
		color: var(--text-color);
	}

	.about-location {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--fs-base);
		color: var(--neutral-600);
	}

	/* The chevron rides at the start of its word (li is nowrap), so it never starts a
	   line alone, and content: '' keeps it out of the item names. */
	.about-phrases {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2) var(--sp-3);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--fs-lg);
		font-style: italic;
		font-weight: 400;
		color: var(--text-secondary);
	}

	.about-phrases li {
		white-space: nowrap;
	}

	.about-phrases li + li::before {
		content: '';
		display: inline-block;
		inline-size: 0.4em;
		block-size: 0.4em;
		margin-inline-end: var(--sp-3);
		border-block-start: 2px solid var(--accent-text);
		border-inline-end: 2px solid var(--accent-text);
		transform: translateY(-0.1em) rotate(45deg);
	}

	/* Capped because the 180px avatar column plus the gap leave the text a
	   column that grows with the viewport: measured at 780px and 98 characters
	   per line from 1280px up, against 73 at 958px and 34 on a phone. Below
	   60ch this is untouched, so the cap only ever applies on a wide screen. */
	.about-bio {
		font-size: var(--fs-base);
		color: var(--text-secondary);
		line-height: var(--lh-normal);
		max-width: var(--measure);
		margin: 0;
	}

	/* Actions */
	.about-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.btn-cv {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		block-size: 2.5rem;
		box-sizing: border-box;
		padding: 0.5rem 1.1rem;
		border-radius: var(--radius-md);
		background: var(--accent-surface);
		color: var(--accent-surface-text);
		font-size: var(--fs-sm);
		font-weight: 700;
		text-decoration: none;
		border: 1px solid transparent;
		transition: opacity var(--dur) var(--ease);
	}

	.btn-cv:hover {
		opacity: 0.88;
		text-decoration: none;
		color: var(--accent-surface-text);
	}

	.btn-social {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		block-size: 2.5rem;
		box-sizing: border-box;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--control-border);
		background: var(--card-background);
		color: var(--text-color);
		font-size: var(--fs-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color var(--dur) var(--ease),
			color var(--dur) var(--ease);
	}

	.btn-social__icon {
		inline-size: 1rem;
		block-size: 1rem;
		flex: none;
		background-color: currentColor;
		mask: var(--icon) center / contain no-repeat;
		-webkit-mask: var(--icon) center / contain no-repeat;
	}

	/* Spec 048: the hero's buttons are 44px tall under a finger (40px otherwise). */
	@media (pointer: coarse) {
		.btn-cv,
		.btn-social {
			block-size: 44px;
		}
	}

	.btn-social:hover {
		border-color: var(--accent-text);
		color: var(--accent-text);
		text-decoration: none;
	}

	/* From 64rem the sheet holds tile, text and a phrases column: at 1024px the text keeps about
	   470px beside the phrases, and the name spans both, so it stays on one line. The content
	   column dissolves into the grid so the markup order (name, phrases, bio) never changes. */
	@media (min-width: 64rem) {
		.about-grid {
			grid-template-columns: 160px minmax(0, 1fr) max-content;
			grid-template-areas:
				'avatar meta meta'
				'avatar bio phrases'
				'avatar actions phrases';
			/* The phrases column runs taller than bio and actions; the last row takes the surplus, so
			   the buttons keep the 1rem gap under the bio (44px without it at 1280px). */
			grid-template-rows: auto auto 1fr;
			row-gap: 1rem;
		}

		.about-avatar { grid-area: avatar; }
		.about-content { display: contents; }
		.about-meta { grid-area: meta; }
		.about-bio { grid-area: bio; }
		.about-actions { grid-area: actions; align-self: start; }

		/* Stacked, the phrases read as a list; a gold check at each, joined by gold segments, keeps
		   them a flow (owner, spec 035). The check is hollow, so the line is drawn between checks, never
		   through one; 0.75em is half the 1.5 line box, where each check is centred. */
		.about-phrases {
			--dot: 1.25rem;
			--seg-gap: 3px;
			grid-area: phrases;
			align-self: center;
			position: relative;
			flex-direction: column;
			gap: var(--sp-3);
			padding-inline-start: calc(var(--dot) + var(--sp-3));
			font-size: var(--fs-xl);
			line-height: 1.5;
		}

		.about-phrases li {
			position: relative;
		}

		.about-phrases li::before,
		.about-phrases li + li::before {
			content: '';
			position: absolute;
			inset-inline-start: calc(-1 * (var(--dot) + var(--sp-3)));
			inset-block-start: calc(0.75em - var(--dot) / 2);
			inline-size: var(--dot);
			block-size: var(--dot);
			margin: 0;
			border: 0;
			background: var(--accent-text);
			mask: url(/icons/ui/circle-check.svg) center / contain no-repeat;
			-webkit-mask: url(/icons/ui/circle-check.svg) center / contain no-repeat;
			transform: none;
		}

		/* From under this check to over the next: the item, the gap, less one check and two gaps. */
		.about-phrases li:not(:last-child)::after {
			content: '';
			position: absolute;
			inset-inline-start: calc(-1 * (var(--dot) + var(--sp-3)) + var(--dot) / 2 - 1px);
			inset-block-start: calc(0.75em + var(--dot) / 2 + var(--seg-gap));
			inline-size: 2px;
			block-size: calc(100% + var(--sp-3) - var(--dot) - 2 * var(--seg-gap));
			background: var(--accent-text);
		}
	}

	/* Responsive */
	/* One column on a phone, but the tile beside the name rather than above it (owner, spec 035):
	   the content column dissolves so the name can share the first row with the tile. */
	@media (max-width: 720px) {
		.about-grid {
			grid-template-columns: 5.5rem minmax(0, 1fr);
			grid-template-areas:
				'avatar meta'
				'phrases phrases'
				'bio bio'
				'actions actions';
			gap: 1rem;
			text-align: left;
		}

		.about-content { display: contents; }
		.about-meta { grid-area: meta; }
		.about-phrases { grid-area: phrases; }
		.about-bio { grid-area: bio; }
		.about-actions { grid-area: actions; }

		.about-avatar {
			grid-area: avatar;
			width: 5.5rem;
			height: 5.5rem;
			padding: var(--sp-2);
		}
	}

	/* Spec 047: where the four phrases do not fit on one line, two per line, the break held by an
	   ordered ::after and no chevron starting phrase 3. Each number is the locale's one-line row (es
	   402px, en 338px) plus the chrome around it: 72px to 30rem, 112px above it (the page gutter
	   joins), the 4vw sheet padding after 500px; es lands at 516px, en at 410px, rounded up. */
	@media (max-width: 32.5rem) {
		.about-phrases:lang(es) { row-gap: 0; }
		.about-phrases:lang(es)::after { content: ''; flex-basis: 100%; block-size: var(--sp-2); order: 1; }
		.about-phrases:lang(es) li:nth-child(n + 3) { order: 2; }
		.about-phrases:lang(es) li:nth-child(3)::before { content: none; }
	}

	@media (max-width: 26rem) {
		.about-phrases:lang(en) { row-gap: 0; }
		.about-phrases:lang(en)::after { content: ''; flex-basis: 100%; block-size: var(--sp-2); order: 1; }
		.about-phrases:lang(en) li:nth-child(n + 3) { order: 2; }
		.about-phrases:lang(en) li:nth-child(3)::before { content: none; }
	}
</style>
