---
import AvatarCircle from './AvatarCircle.astro';
import { ABOUT, JsonLdAbout } from '../data/about';
import { t } from '@i18n/index';

export interface Props {
	lang?: 'es' | 'en';
	withJsonLd?: boolean;
}

const { lang = 'es', withJsonLd = true } = Astro.props;
const personJsonLd = withJsonLd ? JsonLdAbout : null;

// Through t(), not a lang ternary. These were `lang === 'es' ? 'Descargar CV' :
// 'Download CV'`, which puts prose in the component where no translator looks
// and makes a locale switch depend on a second mechanism beside this one.
const cvLabel       = t('about.cv');
const actionsLabel  = t('about.actions');
const locationLabel = t('about.location');

/*
 * Two markup decisions, kept here rather than in the template: Astro emits
 * anything in the template body verbatim, so a note written there reaches every
 * visitor as an HTML comment.
 *
 * Identity mark. The artwork is an opaque white square logo, so it is
 * presented as a square on a field rather than cropped into a circle and
 * framed like a portrait photo.
 *
 * The middle dot that used to sit between the job title and the location was
 * aria-hidden, so assistive tech heard "Full-Stack DeveloperCosta Rica" with no
 * separator at all, while sighted readers saw a bullet — a template tell that
 * added a pause and told nobody anything. The pin already marks the location.
 */
---

<section class='section' id='About' aria-labelledby='about-title'>
	{personJsonLd && (
		<script type='application/ld+json' set:html={JSON.stringify(personJsonLd)} />
	)}

	<div class='about-grid'>
		<div class='about-avatar'>
			<AvatarCircle
				src={ABOUT.avatar}
				alt={ABOUT.name}
				size='100%'
				shape='square'
			/>
		</div>

		<!-- Content -->
		<div class='about-content'>
			<div class='about-meta'>
				<h1 id='about-title' class='about-name'>{ABOUT.name}</h1>
				<div class='about-sub'>
					<span class='about-job'>{ABOUT.title}</span>
					<span class='about-location' aria-label={locationLabel}>
						<svg xmlns='http://www.w3.org/2000/svg' width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z'/><circle cx='12' cy='10' r='3'/></svg>
						{ABOUT.location}
					</span>
				</div>
			</div>

			<p class='about-bio'>{ABOUT.bio[lang]}</p>

			<nav class='about-actions' aria-label={actionsLabel}>
				<a
					class='btn-cv'
					href={ABOUT.resumeUrl}
					download
				>
					<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' y1='15' x2='12' y2='3'/></svg>
					{cvLabel}
				</a>

				{ABOUT.socials.map((s) => (
					<a
						class='btn-social'
						href={s.href}
						target='_blank'
						rel='noopener noreferrer me'
						aria-label={s.label}
						title={s.label}
					>
						{s.label}
					</a>
				))}
			</nav>
		</div>
	</div>
</section>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: 180px 1fr;
		align-items: center;
		gap: 2rem;
	}

	/* Avatar column */
	.about-avatar {
		width: 180px;
		height: 180px;
	}

	/* Content column */
	.about-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.about-meta {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	/* Fluid between the two sizes that actually work. A fixed --fs-4xl measured
	   623px against a 780px column, so it holds one line on a desktop — but the
	   same string in a 273px phone column needs three lines at 52px where 40px
	   gives two. The clamp lands on 40px at 360px wide and reaches --fs-4xl by
	   about 958px, so neither end pays for the other.

	   Weight was 800, which is outside the 100-700 range the variable font
	   declares: it was being clamped to 700 while the CSS claimed otherwise. */
	.about-name {
		font-size: clamp(2.5rem, 2rem + 2.2vw, var(--fs-4xl));
		font-weight: 700;
		color: var(--accent-text);
		margin: 0;
		line-height: var(--lh-tight);
		letter-spacing: -0.01em;
	}

	.about-sub {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.about-job {
		font-size: var(--fs-sm);
		font-weight: 700;
		color: var(--text-color);
	}

	.about-location {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--fs-sm);
		color: var(--neutral-600);
	}

	/* Capped because the 180px avatar column plus the gap leave the text a
	   column that grows with the viewport: measured at 780px and 98 characters
	   per line from 1280px up, against 73 at 958px and 34 on a phone. Below
	   60ch this is untouched, so the cap only ever applies on a wide screen. */
	.about-bio {
		font-size: var(--fs-base);
		color: var(--text-secondary);
		line-height: var(--lh-normal);
		max-width: var(--measure);
		margin: 0;
	}

	/* Actions */
	.about-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.btn-cv {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 1.1rem;
		border-radius: var(--radius-md);
		background: var(--accent-surface);
		color: #fff;
		font-size: var(--fs-sm);
		font-weight: 700;
		text-decoration: none;
		border: 1px solid transparent;
		transition: opacity var(--dur) var(--ease);
	}

	.btn-cv:hover {
		opacity: 0.88;
		text-decoration: none;
		color: #fff;
	}

	.btn-social {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		background: var(--card-background);
		color: var(--text-color);
		font-size: var(--fs-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color var(--dur) var(--ease),
			color var(--dur) var(--ease);
	}

	.btn-social:hover {
		border-color: var(--accent-text);
		color: var(--accent-text);
		text-decoration: none;
	}

	/* Responsive */
	@media (max-width: 720px) {
		.about-grid {
			grid-template-columns: 1fr;
			text-align: left;
		}

		.about-avatar {
			width: 120px;
			height: 120px;
		}
	}
</style>
