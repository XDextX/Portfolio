---
/** Circular avatar image, optionally a link. */
interface Props {
	/** Path to the main image */
	src: string;

	/** Alt text. Omit it and the image becomes decorative (aria-hidden) */
	alt?: string;

	/** Image shown on hover (optional) */
	hoverSrc?: string;

	/** Base size: any CSS length, or a px number. @default '100%' */
	size?: number | string;

	/** Size in px from 480px up. Overrides `size`. */
	sizeSm?: number;

	/** Size in px from 768px up. Overrides `sizeSm`. */
	sizeMd?: number;

	/** Size in px from 1024px up. Overrides `sizeMd`. */
	sizeLg?: number;

	/** Enables fluid sizing with clamp(min, vw, max). @default false */
	fluid?: boolean;

	/** Fluid lower bound in px. @default 72 */
	fluidMin?: number;

	/** Fluid upper bound in px. @default 144 */
	fluidMax?: number;

	/** Fluid step, read as vw: 12 means 12vw. @default 12 */
	fluidViewport?: number;

	/** Draws the ring around the image. @default true */
	border?: boolean;

	/** Ring width in px. @default 2 */
	ringWidth?: number;

	/** Renders the image as a link */
	href?: string;

	/** Opens `href` in a new tab with a safe rel. @default false */
	newTab?: boolean;
}

const {
	src,
	alt,
	hoverSrc,
	size = '100%',
	sizeSm,
	sizeMd,
	sizeLg,
	fluid = false,
	fluidMin = 72,
	fluidMax = 144,
	fluidViewport = 12,
	border = true,
	ringWidth = 2,
	href,
	newTab = false,
} = Astro.props;

const isDecorative = !alt || alt.trim() === '';
const Wrapper = href ? 'a' : 'div';
const rel = newTab ? 'noopener noreferrer' : undefined;
const target = newTab ? '_blank' : undefined;

// Breakpoint sizes ride along as custom properties rather than data attributes.
// The old markup emitted data-size-* and read them with attr(data-size-sm px),
// which no browser supports for non-content properties, so every one of these
// props was silently ignored.
const px = (n: number | undefined) => (n === undefined ? undefined : `${n}px`);
---

<style>
	.avatar {
		position: relative;
		inline-size: var(--size);
		block-size: var(--size);
		border-radius: 50%;
		overflow: hidden;
		display: inline-grid;
		place-items: center;
		box-shadow: var(--shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.06));
		transition:
			transform var(--dur, 200ms) var(--ease, cubic-bezier(0.2, 0.8, 0.2, 1)),
			box-shadow var(--dur, 200ms) var(--ease, cubic-bezier(0.2, 0.8, 0.2, 1));
		will-change: transform;
	}
	.avatar:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-md, 0 4px 10px rgba(0, 0, 0, 0.08));
	}

	/* Theme-aware border. --avatar-ring already resolves per theme (it is
	   aliased to --color-border, which both themes redefine), so no dark-mode
	   override is needed here — that block referenced an undefined token and
	   discarded the whole `border` shorthand. The fallback keeps the ring if
	   --avatar-ring is ever removed from the token sheet. */
	.avatar.has-border {
		border: var(--ring) solid var(--avatar-ring, var(--color-border));
	}

	.img,
	.img-hover {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		display: block;
	}

	/* Hover effect: top image fades in */
	.stack {
		position: relative;
		inline-size: 100%;
		block-size: 100%;
	}
	.img-hover {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity var(--dur, 200ms)
			var(--ease, cubic-bezier(0.2, 0.8, 0.2, 1));
	}
	.avatar:hover .img-hover {
		opacity: 1;
	}

	/* Reduced motion: skip animations */
	@media (prefers-reduced-motion: reduce) {
		.avatar,
		.img-hover {
			transition: none !important;
		}
	}

	/* Responsive: data-size-* only marks that the prop was supplied; the value
	   itself is read from the custom property set inline. The old version read
	   it with attr(data-size-sm px), which no browser supports for non-content
	   properties, so every breakpoint prop was silently ignored.
	   !important is required: an inline --size would otherwise win. */
	@media (min-width: 480px) {
		.avatar[data-size-sm]:not([data-fluid='true']) {
			--size: var(--size-sm) !important;
		}
	}
	@media (min-width: 768px) {
		.avatar[data-size-md]:not([data-fluid='true']) {
			--size: var(--size-md) !important;
		}
	}
	@media (min-width: 1024px) {
		.avatar[data-size-lg]:not([data-fluid='true']) {
			--size: var(--size-lg) !important;
		}
	}

	/* Fluid size with clamp(): data-fluid ignores the fixed sizes */
	.avatar[data-fluid='true'] {
		--size: clamp(var(--min, 72px), var(--vw, 12vw), var(--max, 144px));
	}

	/* Links: accessible focus */
	.avatar.is-link {
		outline: none;
	}
	.avatar.is-link:focus-visible {
		outline: 2px solid var(--avatar-ring, var(--color-border));
		outline-offset: 4px;
	}
</style>

<Wrapper
	class:list={['avatar', border && 'has-border', href && 'is-link']}
	href={href}
	target={target}
	rel={rel}
	style={{
		'--ring': `${ringWidth}px`,
		'--min': `${fluidMin}px`,
		'--max': `${fluidMax}px`,
		'--vw': `${fluidViewport}vw`,
		'--size': `${size}`,
		...(sizeSm ? { '--size-sm': px(sizeSm) } : {}),
		...(sizeMd ? { '--size-md': px(sizeMd) } : {}),
		...(sizeLg ? { '--size-lg': px(sizeLg) } : {}),
	}}
	{...fluid ? { 'data-fluid': fluid } : {}}
	{...sizeSm ? { 'data-size-sm': sizeSm } : {}}
	{...sizeMd ? { 'data-size-md': sizeMd } : {}}
	{...sizeLg ? { 'data-size-lg': sizeLg } : {}}
	aria-label={isDecorative ? undefined : alt}
	aria-hidden={isDecorative ? 'true' : undefined}
>
	{
		hoverSrc ? (
			<div class='stack' role={isDecorative ? 'presentation' : 'img'}>
				<img
					class='img'
					src={src}
					alt={isDecorative ? '' : alt}
					loading='lazy'
					decoding='async'
				/>
				<img
					class='img-hover'
					src={hoverSrc}
					alt=''
					loading='lazy'
					decoding='async'
				/>
			</div>
		) : (
			<img
				class='img'
				src={src}
				alt={isDecorative ? '' : alt}
				loading='lazy'
				decoding='async'
			/>
		)
	}
</Wrapper>
