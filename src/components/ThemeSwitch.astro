---
import { t } from '@i18n/index';

/*
 * Both icons are always in the DOM; CSS shows the one for the current theme.
 * That is why the note on which is which belongs here rather than beside the
 * markup — Astro emits anything in the template body verbatim, and three of
 * these notes were reaching every visitor on every page.
 *
 * Sun: shown in dark mode, meaning "switch to light".
 * Moon: shown in light mode, meaning "switch to dark".
 * The three small circles on the moon are craters, so the shape reads as a moon
 * rather than a plain circle at 18px.
 */
---

<button
	class='theme-btn'
	type='button'
	data-theme-toggle
	data-label-dark={t('layout.themeToDark')}
	data-label-light={t('layout.themeToLight')}
	aria-label={t('layout.themeToDark')}
>
	<svg
		class='icon icon--sun'
		xmlns='http://www.w3.org/2000/svg'
		width='18'
		height='18'
		viewBox='0 0 24 24'
		fill='none'
		stroke='currentColor'
		stroke-width='2'
		stroke-linecap='round'
		stroke-linejoin='round'
		aria-hidden='true'
	>
		<circle cx='12' cy='12' r='4'></circle>
		<path
			d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41'
		></path>
	</svg>
	<svg
		class='icon icon--moon'
		xmlns='http://www.w3.org/2000/svg'
		width='18'
		height='18'
		viewBox='0 0 24 24'
		fill='none'
		stroke='currentColor'
		stroke-width='2'
		stroke-linecap='round'
		stroke-linejoin='round'
		aria-hidden='true'
	>
		<path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path>
		<circle cx='15.5' cy='8' r='1.1' fill='currentColor' stroke='none' opacity='0.45'></circle>
		<circle cx='8' cy='13.5' r='1.4' fill='currentColor' stroke='none' opacity='0.35'></circle>
		<circle cx='12' cy='18' r='0.9' fill='currentColor' stroke='none' opacity='0.3'></circle>
	</svg>
</button>

<script>
	function applyTheme(theme: string, persist: boolean) {
		if (theme === 'dark') {
			document.documentElement.setAttribute('data-theme', 'dark');
		} else {
			document.documentElement.removeAttribute('data-theme');
		}
		// Only write when the user actually toggles: restoring the saved theme
		// happens on every navigation and would otherwise rewrite the same
		// value into localStorage each time.
		if (persist) localStorage.setItem('theme', theme);
	}

	function currentTheme(): string {
		return document.documentElement.getAttribute('data-theme') ?? 'light';
	}

	// Re-bound on every navigation: with <ClientRouter /> the DOM is replaced,
	// so a listener bound once would die after the first transition.
	// No global id — the button is found by data attribute, so several
	// instances on one page work independently.
	document.addEventListener('astro:page-load', () => {
		document
			.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
			.forEach((btn) => {
				const saved = localStorage.getItem('theme') ?? 'light';
				applyTheme(saved, false);

				const setLabel = (theme: string) =>
					btn.setAttribute(
						'aria-label',
						theme === 'dark'
							? (btn.dataset.labelLight ?? 'Switch to light mode')
							: (btn.dataset.labelDark ?? 'Switch to dark mode'),
					);

				setLabel(saved);

				btn.addEventListener('click', () => {
					const next = currentTheme() === 'dark' ? 'light' : 'dark';
					applyTheme(next, true);
					setLabel(next);
				});
			});
	});
</script>

<style>
	.theme-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--card-background);
		color: var(--text-color);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0;
		cursor: pointer;
		transition: background var(--dur) var(--ease);
		/* Must match .language-switcher exactly: these two sit in one row and a
		   sub-pixel difference reads as crooked. Both were measured at 29.00 and
		   29.59 before this, because each derived its height from a different
		   padding. An explicit height with border-box (global, 01-base.css)
		   stops padding from adding to it.

		   A literal, not a token: two controls are not a design system, and a
		   --control-h would imply there is one. */
		block-size: 30px;
		inline-size: 34px;
	}

	/* No hover rule here on purpose. The theme owns it, in light.css and
	   dark.css, because a theme-specific hover cannot live in a component.

	   This used to carry `background: var(--neutral-200)` and it was never
	   visible in a rest-state screenshot. Its selector compiles to
	   (0,3,0) against the (0,2,0) of `:root .theme-btn:hover` in the theme
	   files, so in light it won on cascade order and painted the old neutral
	   under the gold border and gold icon: measured #DCE2E9 against a
	   white ground. In dark the `:root[data-theme="dark"]` variant reaches
	   (0,4,0) and wins, so the same control hovered two different ways
	   depending on the theme — and the gold fell from 6.18 to 4.73 contrast
	   in light, where it had been measured at 6.18 all along. */

	/* The icon shows the theme you are switching TO, not the current one.
   Light theme -> moon (going to dark). Dark theme -> sun (going to light).
   This matches GitHub, Tailwind and Material. */
	.icon--sun {
		display: none;
	}
	.icon--moon {
		display: block;
	}

	:global([data-theme='dark']) .icon--sun {
		display: block;
	}
	:global([data-theme='dark']) .icon--moon {
		display: none;
	}
</style>
