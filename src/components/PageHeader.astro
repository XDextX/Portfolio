---
import HeroBackground from '@components/HeroBackground.astro';

interface Props {
	lead?: string;
}

/**
 * A route's header (spec 044, from spec 039's /proyectos header): band, `before` slot, gold tile
 * beside the `title` slot, a lead line, the default slot below.
 * @param lead the sentence under the title
 */
const { lead } = Astro.props as Props;
---

<header class='page-header' transition:animate='none'>
	<HeroBackground variant='header' />
	<slot name='before' />
	<div class='page-header__row'>
		<span class='page-header__tile' aria-hidden='true'></span>
		<slot name='title' />
	</div>
	{lead && <p class='page-header__lead'>{lead}</p>}
	<slot />
</header>

<style>
	/* The band (spec 036) draws under the header's content and reaches the sheet's top edge. */
	.page-header {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.page-header__row {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
	}

	.page-header__tile {
		flex: none;
		inline-size: 3rem;
		block-size: 3rem;
		border-radius: var(--radius-md);
		background: var(--accent-surface);
	}

	/* Painted through the glyph's own alpha, so it follows the theme (AGENTS, UI icons). */
	.page-header__tile::before {
		content: '';
		display: block;
		inline-size: 100%;
		block-size: 100%;
		background-color: var(--accent-surface-text);
		-webkit-mask: url(/icons/ui/folder.svg) center / 60% no-repeat;
		mask: url(/icons/ui/folder.svg) center / 60% no-repeat;
	}

	.page-header__lead {
		margin: 0;
		max-width: var(--measure);
		color: var(--text-secondary);
	}
</style>
