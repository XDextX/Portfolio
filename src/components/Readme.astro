---
import type { GitHubRepo } from '@type/github';
import { t } from '@i18n/index';

interface Props {
	repo: GitHubRepo;
}
const { repo } = Astro.props;

// A repo without a README answers 404 with a JSON body; reading it as text would
// print `{"error":...}` in the article, so the status is checked instead. set:html
// below is remote HTML, unsanitised here — a decision, not an oversight: GitHub's
// readme endpoint sanitises what it renders and the repos are the owner's own. If
// that changes, sanitise at the endpoint rather than in this consumer.
let readmeText = '';
let available = false;

try {
	const res = await fetch(
		`${Astro.url.origin}/api/v1/projects/readme/${repo.owner.login}/${repo.name}/readme.json`
	);
	if (res.ok) {
		readmeText = await res.text();
		available = true;
	}
} catch {
	readmeText = '';
	available = false;
}
---

{
	available ? (
		<article class='readme-body' set:html={readmeText} />
	) : (
		<p class='readme-missing'>{t('project.readme.missing')}</p>
	)
}

<style>
	.readme-missing {
		color: var(--neutral-600);
		font-size: var(--fs-sm);
		margin: 0;
	}
</style>
