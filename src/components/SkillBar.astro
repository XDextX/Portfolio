---
import { LEVEL_FILL, LEVEL_COLOR, LEVEL_TEXT_COLOR, levelLabelMap, type TechLevel } from '../data/levelLabels';

export interface Props {
	name: string;
	icon: string;
	brand?: string;
	level: TechLevel;
	locale?: 'es' | 'en';
}

/**
 * One bars-view skill row: icon, name over track, level badge.
 * @param name tech name shown above the track; icon its single-colour asset URL.
 * @param brand the hover colour, absent for a generic icon; level drives fill and label.
 */

/*
 * The bar repeats what the label beside it says in words, so it is hidden from
 * assistive tech. It used to announce "85 percent" and then "Avanzado" again —
 * a precision the data lacks, stated twice. This shipped 271 characters a page.
 */

const { name, icon, brand, level, locale = 'es' } = Astro.props;
const fill      = LEVEL_FILL[level];
const color     = LEVEL_COLOR[level];
const textColor = LEVEL_TEXT_COLOR[level];
const label     = levelLabelMap[locale][level];
---

<li class='bar-row'>
	<span class='bar-logo' aria-hidden='true' style={`--logo: url("${icon}")${brand ? `; --brand: ${brand}` : ''}`}></span>
	<div class='bar-main'>
		<span class='bar-name'>{name}</span>
		<div class='bar-track' aria-hidden='true'>
			<div class='bar-fill' style={`--pct:${fill}%;--clr:${color}`} />
		</div>
	</div>
	<span class='level-tag' style={`color:${textColor}`}>{label}</span>
</li>

<style>
	/* Icon and level are fixed; the middle column is minmax(60px, 1fr), so a
	   long name ellipsizes instead of squeezing the track below its floor. */
	.bar-row {
		display: grid;
		grid-template-columns: 22px minmax(60px, 1fr) auto;
		align-items: center;
		gap: 0.6rem;
	}

	/* The icon is the asset's alpha painted in the slot's colour, so one
	   `color` change recolours it. The asset must be single-colour: white
	   lettering over a field reads as a hole only if it is one (RF-8).
	   The 22px box is the slot, held here rather than by the asset arriving. */
	.bar-logo {
		position: relative;
		width: 22px;
		height: 22px;
		color: var(--icon-mono);
	}

	.bar-logo::before {
		content: '';
		position: absolute;
		inset: 0;
		background-color: currentColor;
		mask: var(--logo) center / contain no-repeat;
		-webkit-mask: var(--logo) center / contain no-repeat;
	}

	/* The hover changes the icon's colour and nothing else; a row with no
		brand keeps the theme's. It sets `color`, not a background, so it is
		not a background-only hover. Gated on (hover: hover): touch applies
		:hover on tap and keeps it, and a device with no hover stays mono. */
	@media (hover: hover) {
		.bar-row:hover .bar-logo {
			color: var(--brand, var(--icon-mono));
		}
	}

	.bar-main {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		min-width: 0;
	}

	.bar-name {
		font-size: var(--fs-sm);
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
	}

	.bar-track {
		height: 8px;
		background: var(--neutral-200);
		border-radius: var(--radius-pill);
		overflow: hidden;
	}

	/* The width is the truth and it lives in CSS. It used to be `width: 0`,
	   with `.animated` (added by TechGrid's script) carrying the real value —
	   so with JavaScript off the component rendered ten empty tracks and said
	   nothing at all. The animation is now the enhancement rather than the
	   value: no script, no motion, and the bar is still at its level. */
	.bar-fill {
		height: 100%;
		width: var(--pct);
		background: var(--clr);
		border-radius: var(--radius-pill);
	}

	.bar-fill.animated {
		animation: bar-grow 0.7s var(--ease) both;
	}

	@keyframes bar-grow {
		from {
			width: 0;
		}
		to {
			width: var(--pct);
		}
	}

	/* A 0.7s width animation is exactly the kind of motion reduced-motion is
	   asking not to see. The bar is still correct, it just arrives. */
	@media (prefers-reduced-motion: reduce) {
		.bar-fill.animated {
			animation: none;
		}
	}

	/* The level shrinks before anything else: capped by max-width, two lines
	   at most with ellipsis, never hidden and never a fixed pixel width. */
	.level-tag {
		/* The label's own pill: the soft fill inside the sheet, one
		   colour for that job in both themes. On the card face the
		   dark intermediate label is 4.13:1; on this surface every
		   level clears 4.5:1 in both themes. */
		background: var(--tag-surface);
		border-radius: var(--radius-pill);
		padding: 0.15rem 0.5rem;
		font-size: var(--fs-xs);
		font-weight: 600;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		overflow-wrap: break-word;
		max-width: 7rem;
		min-width: 0;
		text-align: right;
	}
</style>
