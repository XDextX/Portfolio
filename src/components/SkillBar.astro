---
import { LEVEL_FILL, LEVEL_COLOR, LEVEL_TEXT_COLOR, levelLabelMap, type TechLevel } from '../data/levelLabels';

export interface Props {
	name: string;
	logo: string;
	level: TechLevel;
	locale?: 'es' | 'en';
}

/*
 * The bar repeats what the label beside it says in words, so it is hidden from
 * assistive tech. It used to be a role="progressbar" with aria-valuenow, which
 * made a reader announce "85 percent" and then say "Avanzado" again — a
 * precision the data does not have, stated twice.
 *
 * The note lives here because Astro emits anything in the template body
 * verbatim: this one was shipping 271 characters to every visitor.
 */

const { name, logo, level, locale = 'es' } = Astro.props;
const fill      = LEVEL_FILL[level];
const color     = LEVEL_COLOR[level];
const textColor = LEVEL_TEXT_COLOR[level];
const label     = levelLabelMap[locale][level];
---

<li class='bar-row'>
	<img src={logo} alt='' width='22' height='22' loading='lazy' />
	<span class='bar-name'>{name}</span>
	<div class='bar-track' aria-hidden='true'>
		<div class='bar-fill' style={`--pct:${fill}%;--clr:${color}`} />
	</div>
	<span class='level-tag' style={`color:${textColor}`}>{label}</span>
</li>

<style>
	/* The logo and the level tag are fixed; the name may shrink and ellipsize,
	   so a long tech name can never squeeze the track out of existence. The
	   track keeps a 60px floor as a last-resort guard for narrow containers. */
	.bar-row {
		display: grid;
		grid-template-columns: 22px minmax(72px, 130px) minmax(60px, 1fr) auto;
		align-items: center;
		gap: 0.6rem;
	}

	.bar-name {
		font-size: var(--fs-sm);
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bar-track {
		height: 8px;
		background: var(--neutral-200);
		border-radius: 999px;
		overflow: hidden;
	}

	/* The width is the truth and it lives in CSS. It used to be `width: 0`,
	   with `.animated` (added by TechGrid's script) carrying the real value —
	   so with JavaScript off the component rendered ten empty tracks and said
	   nothing at all. The animation is now the enhancement rather than the
	   value: no script, no motion, and the bar is still at its level. */
	.bar-fill {
		height: 100%;
		width: var(--pct);
		background: var(--clr);
		border-radius: 999px;
	}

	.bar-fill.animated {
		animation: bar-grow 0.7s var(--ease) both;
	}

	@keyframes bar-grow {
		from {
			width: 0;
		}
		to {
			width: var(--pct);
		}
	}

	/* A 0.7s width animation is exactly the kind of motion reduced-motion is
	   asking not to see. The bar is still correct, it just arrives. */
	@media (prefers-reduced-motion: reduce) {
		.bar-fill.animated {
			animation: none;
		}
	}

	.level-tag {
		font-size: var(--fs-xs);
		font-weight: 600;
		white-space: nowrap;
		min-width: 5rem;
		text-align: right;
	}

	@media (max-width: 520px) {
		.bar-row {
			grid-template-columns: 22px minmax(0, 1fr) minmax(60px, 1fr);
		}
		.level-tag {
			display: none;
		}
	}
</style>
