---
import SkillLogo from './SkillLogo.astro';
import { LEVEL_SCALE, LEVEL_COLOR, LEVEL_TEXT_COLOR, levelLabelMap, segmentsFor, type TechLevel } from '../data/levelLabels';
import type { Logo } from '../data/tech';

export interface Props {
	name: string;
	logo?: Logo;
	level: TechLevel;
	locale?: 'es' | 'en';
}

/**
 * One bars-view skill row: logo, name over track, level badge.
 * @param name tech name shown above the track; logo its original logo (spec 012).
 * @param level drives fill and label.
 */

/*
 * The bar repeats what the label beside it says in words, so it is hidden from
 * assistive tech. It used to announce "85 percent" and then "Avanzado" again —
 * a precision the data lacks, stated twice. This shipped 271 characters a page.
 */

const { name, logo, level, locale = 'es' } = Astro.props;
const color     = LEVEL_COLOR[level];
const textColor = LEVEL_TEXT_COLOR[level];
const label     = levelLabelMap[locale][level];
---

<li class='bar-row'>
	<span class='bar-logo' aria-hidden='true'><SkillLogo logo={logo} size={22} /></span>
	<div class='bar-main'>
		<span class='bar-name'>{name}</span>
		<div class='bar-track' aria-hidden='true' style={`--clr:${color};--segments:${LEVEL_SCALE.length}`}>
			{segmentsFor(level).map((lit, i) => (
				<span class:list={['bar-seg', { lit }]} style={`--i:${i}`}></span>
			))}
		</div>
	</div>
	<span class='level-tag' style={`color:${textColor}`}>{label}</span>
</li>

<style>
	/* Icon and level are fixed; the middle column is minmax(60px, 1fr), so a
	   long name ellipsizes instead of squeezing the track below its floor. */
	.bar-row {
		display: grid;
		grid-template-columns: 22px minmax(60px, 1fr) auto;
		align-items: center;
		gap: 0.6rem;
	}

	/* The 22px box is the slot, held here rather than by the logo arriving, so a
	   file that fails to load moves nothing. No hover rule: the row is not a control. */
	.bar-logo {
		width: 22px;
		height: 22px;
	}

	.bar-main {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		min-width: 0;
	}

	.bar-name {
		font-size: var(--fs-sm);
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
	}

	/* A health bar (spec 006): one block per level, lit from the left. The
	   frame's padding and the gap are one value, and the segment radius is
	   derived from it, so the blocks come out square inside a 2px corner. */
	.bar-track {
		--bar-pad: 2px;
		display: grid;
		grid-template-columns: repeat(var(--segments), 1fr);
		gap: var(--bar-pad);
		padding: var(--bar-pad);
		border: 2px solid var(--icon-mono);
		border-radius: var(--radius-xs);
	}

	.bar-seg {
		height: 8px;
		background: var(--neutral-200);
		border-radius: calc(var(--radius-xs) - var(--bar-pad));
	}

	/* The lit colour is content, not the animation's end state: with scripts
	   off .animated never arrives and the blocks are still at their level. */
	.bar-seg.lit {
		background: var(--clr);
	}

	.bar-track.animated .bar-seg.lit {
		animation: seg-light 120ms var(--ease) calc(var(--i) * 120ms) both;
	}

	@keyframes seg-light {
		from {
			background: var(--neutral-200);
		}
		to {
			background: var(--clr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bar-track.animated .bar-seg.lit {
			animation: none;
		}
	}

	/* The level shrinks before anything else: capped by max-width, two lines
	   at most with ellipsis, never hidden and never a fixed pixel width. */
	.level-tag {
		/* The label's own pill: the soft fill inside the sheet, one
		   colour for that job in both themes. On the card face the
		   dark intermediate label is 4.13:1; on this surface every
		   level clears 4.5:1 in both themes. */
		background: var(--tag-surface);
		border-radius: var(--radius-pill);
		padding: 0.15rem 0.5rem;
		font-size: var(--fs-xs);
		font-weight: 600;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		overflow-wrap: break-word;
		max-width: 7rem;
		min-width: 0;
		text-align: right;
	}
</style>
