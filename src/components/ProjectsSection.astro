---
import ProjectCard from './ProjectCard.astro';
import type { GitHubRepo } from '../types/github';
import { t } from '@i18n/index';
import SectionTitle from './SectionTitle.astro';
import { SECTION_TITLES } from '../data/sectionTitles';
import { previewPath } from '../pages/lib/github';

export interface Props {
	repos: GitHubRepo[];
	title?: string;
	hideTitle?: boolean;
	locale?: 'es' | 'en';
	/** Max repos shown initially. Omit to show all. */
	preview?: number;
	/**
	 * Reason the fetch failed, if it did. When set, the section renders an
	 * alert instead of the grid, so an API outage is never mistaken for
	 * "you have no projects".
	 */
	error?: string | null;
	/** Names of the repositories with an uploaded social preview (spec 032). */
	previews?: string[];
}

const {
	repos,
	title = t('projects.title'),
	hideTitle = false,
	locale = 'es',
	preview,
	error = null,
	previews = [],
} = Astro.props;

const headingId = SECTION_TITLES.projects.id;
const labelAttrs = hideTitle
	? { 'aria-label': title }
	: { 'aria-labelledby': headingId };

const topic = import.meta.env.GITHUB_TOPIC;
const topicValue = topic?.trim() || t('projects.topicLabel');

// Spec 030: the home shows one row and links to the rest; no toggle, so nothing more is rendered.
const visible = preview ? repos.slice(0, preview) : repos;
const viewAll = t('projects.viewAll');
---

<section
	class='section'
	{...labelAttrs}
	transition:name={`p-${headingId}`}
>
	{
		!hideTitle && (preview ? (
			<header class='projects-head'>
				<SectionTitle section='projects' />
				<p class='projects-lead'>{t('projects.lead')}</p>
				<a class='btn-action projects-all' href='/proyectos'>
					{viewAll}
					<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14' /><path d='M13 6l6 6l-6 6' /></svg>
				</a>
			</header>
		) : <SectionTitle section='projects' />)
	}

	{
		error ? (
			<p class='empty' role='alert'>{t('projects.error', { detail: error })}</p>
		) : repos.length === 0 ? (
			<p class='empty'>{t('projects.empty.message', { topic: topicValue })}</p>
		) : (
			<>
				<div class='projects-grid'>
					{visible.map((r) => (
						<div class='project-item'>
							<ProjectCard repo={r} locale={locale} preview={previews.includes(r.name) ? previewPath(r.name) : null} />
						</div>
					))}
				</div>
			</>
		)
	}
</section>


<style>
	/* The proposal's header: title, line and the way to every project on one row (spec 030). */
	.projects-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-3) var(--sp-6);
		margin-bottom: var(--sp-4);
	}

	.projects-lead {
		flex: 1 1 18rem;
		margin: 0;
		max-width: var(--measure);
		font-size: var(--fs-sm);
		color: var(--text-secondary);
	}

	.projects-all {
		margin-inline-start: auto;
	}

	/* Four cards per row at 1280 (spec 030), stretched to the row's height by the grid. */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
		gap: 1rem;
	}

	.project-item {
		display: grid;
	}


	.empty {
		color: var(--neutral-600);
		font-size: var(--fs-sm);
	}

	.empty[role='alert'] {
		color: var(--danger-color);
	}

</style>
