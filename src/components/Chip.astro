---
export interface Props {
	text: string;
}
const { text } = Astro.props;
---

<span class='chip'>{text}</span>

<style>
	/* A GitHub topic is a tag, not navigation, and a lozenge is its honest shape.
	   The fill was --card-background on a card that is also --card-background,
	   byte-identical to the surface under it — it only read right in the skills
	   list, whose backdrop is the sheet. A filled tag needs no border. */
	.chip {
		display: inline-flex;
		align-items: center;
		font-size: var(--fs-xs);
		font-weight: 500;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-pill);
		background: var(--tag-surface);
		color: var(--text-secondary);
		white-space: nowrap;
	}
</style>
