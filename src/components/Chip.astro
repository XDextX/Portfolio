---
export interface Props {
	text: string;
}
const { text } = Astro.props;
---

<span class='chip'>{text}</span>

<style>
	/* A GitHub topic is a tag: metadata, not navigation. A lozenge is the
	   honest shape for that, and it is why --radius-pill exists.

	   The fill was --card-background on a card that is also --card-background,
	   so the tag rendered as a border and some text with a background doing
	   nothing at all — measured byte-identical to the surface under it. It only
	   looked right in the skills list, where the backdrop is the page sheet
	   rather than a card.

	   A filled tag does not need an outline, so the border goes. */
	.chip {
		display: inline-flex;
		align-items: center;
		font-size: var(--fs-xs);
		font-weight: 500;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-pill);
		background: var(--tag-surface);
		color: var(--text-secondary);
		white-space: nowrap;
	}
</style>
