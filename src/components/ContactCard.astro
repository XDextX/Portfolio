---
import type { ContactItem } from '../types/contact';
import SkillLogo from './SkillLogo.astro';
import { contactLabel, copyValue, FEEDBACK_MS } from '../utils/contact';
import { t } from '@i18n/index';

export interface Props {
	item: ContactItem;
}

/**
 * One contact card: the channel's logo, its value as a link (on a desktop), and copy and open controls.
 * @param item the contact; its kind decides what a copy writes and whether links open outside
 */
const { item } = Astro.props;

const label      = contactLabel(item, t);
const copy       = copyValue(item);
const isExternal = item.kind !== 'email' && item.kind !== 'phone';
const rel        = isExternal ? 'noopener noreferrer me' : undefined;
const target     = isExternal ? '_blank' : undefined;

const copyAria   = t('contact.actions.copyAria', { label });
const openAria   = t('contact.actions.openAria', { label });
const copied     = t('contact.actions.copied');
const error      = t('contact.actions.error');
const copiedLive = t('contact.actions.copiedLive', { label });
const errorLive  = t('contact.actions.errorLive', { label });
---

<article
	class='contact-card'
	aria-label={`${label}: ${item.value}`}
>
	<!-- Icon -->
	<span class='contact-icon'>
		{item.glyph
			? <span class='contact-glyph' aria-hidden='true' style={`--icon: url(${item.glyph})`}></span>
			: <SkillLogo logo={item.icon} size={28} />}
	</span>

	<!-- Info -->
	<div class='contact-info'>
		<span class='contact-label'>{label}</span>
		<a class='contact-value' href={item.href} rel={rel} target={target}>{item.value}</a>
	</div>

	<!-- Actions -->
	<div class='contact-actions'>
		<button class='icon-btn copy-btn' data-copy={copy} data-feedback-ms={FEEDBACK_MS} aria-label={copyAria} title={copyAria}>
			<svg class='copy-btn__icon' xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
				<rect x='9' y='9' width='13' height='13' rx='2' ry='2'/>
				<path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'/>
			</svg>
			<span class='copy-btn__ok' aria-hidden='true'>{copied}</span>
			<span class='copy-btn__err' aria-hidden='true'>{error}</span>
		</button>

		<a class='icon-btn' href={item.href} rel={rel} target={target} aria-label={openAria} title={openAria}>
			<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
				<line x1='7' y1='17' x2='17' y2='7'/><polyline points='7 7 17 7 17 17'/>
			</svg>
		</a>
	</div>

	<p class='sr-only' aria-live='polite' data-copy-live data-live-ok={copiedLive} data-live-err={errorLive}></p>
</article>

<script>
	// Spec 018: the label is a class toggle over one grid cell, never an innerHTML swap, so
	// the control keeps its size; the live region is cleared first so a repeat reads again.
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
			const live = btn.closest('article')?.querySelector<HTMLElement>('[data-copy-live]');
			const ms = Number(btn.dataset.feedbackMs);
			let timer: ReturnType<typeof setTimeout> | undefined;
			btn.addEventListener('click', async () => {
				clearTimeout(timer);
				let ok = true;
				try {
					await navigator.clipboard.writeText(btn.dataset.copy ?? '');
				} catch {
					ok = false;
				}
				btn.classList.toggle('copy-btn--ok', ok);
				btn.classList.toggle('copy-btn--err', !ok);
				if (live) {
					live.textContent = '';
					requestAnimationFrame(() => { live.textContent = (ok ? live.dataset.liveOk : live.dataset.liveErr) ?? ''; });
				}
				timer = setTimeout(() => btn.classList.remove('copy-btn--ok', 'copy-btn--err'), ms);
			});
		});
	});
</script>

<style>
	.contact-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--card-background);
		transition:
			border-color var(--dur) var(--ease),
			box-shadow var(--dur) var(--ease);
	}

	/* Hover moves the border, not the box — the same signal as the chips and
	   the project cards, so hover means one thing on this page. Lifting the card
	   on every pointer pass was decoration, and translating the element fought
	   the shared theme transition on .card. */
	.contact-card:hover {
		border-color: var(--accent-text);
		box-shadow: var(--shadow-md);
	}

	.contact-icon {
		flex-shrink: 0;
		opacity: 0.9;
	}

	/* A site glyph in the gold accent, as the proposal's envelope (spec 029); a mask, so it
	   follows the theme. 28px, the logos' size. */
	.contact-glyph {
		display: block;
		inline-size: 28px;
		block-size: 28px;
		background-color: var(--accent-text);
		mask: var(--icon) center / contain no-repeat;
		-webkit-mask: var(--icon) center / contain no-repeat;
	}

	.contact-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		flex: 1;
		min-width: 0;
	}

	.contact-label {
		font-size: var(--fs-xs);
		font-weight: 600;
		color: var(--neutral-600);
	}

	.contact-value {
		font-size: var(--fs-sm);
		font-weight: 600;
		color: var(--text-color);
		text-decoration: none;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* Spec 045: on a phone the value is not drawn (it was cut at 360 and 390): the card keeps its
	   icon, a label in the value's type, and the controls, which still act on the value. Spec 035's
	   single-column line, the same literal as AboutSection's query. */
	@media (max-width: 720px) {
		.contact-value {
			display: none;
		}

		.contact-label {
			font-size: var(--fs-sm);
			color: var(--text-color);
		}
	}

	.contact-value:hover {
		color: var(--accent-text);
		text-decoration: underline;
	}

	.contact-actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
	}

	/* Icon and both labels stack in one cell, the inactive ones hidden but sized, so the
	   control is as wide as its longest state in each locale (AGENTS, label swap). */
	.icon-btn {
		display: inline-grid;
		grid-template-areas: 'stack';
		place-items: center;
		block-size: 2rem;
		min-inline-size: 2rem;
		box-sizing: border-box;
		padding-inline: var(--sp-2);
		border-radius: var(--radius-md);
		border: 1px solid var(--control-border);
		background: transparent;
		color: var(--neutral-600);
		cursor: pointer;
		text-decoration: none;
		font-size: var(--fs-xs);
		font-weight: 700;
		transition:
			background var(--dur) var(--ease),
			color var(--dur) var(--ease),
			border-color var(--dur) var(--ease);
	}

	/* Spec 048: 44px under a finger. The value link grows by padding, so its ellipsis stays. */
	@media (pointer: coarse) {
		.icon-btn {
			block-size: 44px;
			min-inline-size: 44px;
		}

		.contact-value {
			padding-block: calc((44px - 1lh) / 2);
		}
	}

	.icon-btn:hover {
		background: var(--accent-surface);
		color: var(--accent-surface-text);
		border-color: var(--accent-text);
		text-decoration: none;
	}

	.icon-btn > * {
		grid-area: stack;
	}

	.copy-btn__ok,
	.copy-btn__err,
	.copy-btn--ok .copy-btn__icon,
	.copy-btn--err .copy-btn__icon {
		visibility: hidden;
	}

	.copy-btn--ok .copy-btn__ok,
	.copy-btn--err .copy-btn__err {
		visibility: visible;
	}
</style>
