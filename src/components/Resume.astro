---
import type { GitHubRepo } from '../types/github';
import ExperienceSection from './ExperienceSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import HabilitiesSection from './HabilitiesSection.astro';
import ContactSection from './ContactSection.astro';
import AboutSection from './AboutSection.astro';
import ValuePropositionSection from './ValuePropositionSection.astro';
import { applyLocale } from '@utils/locale';
import { listRepos, listPreviewNames, sortRepos } from '@lib/github';
import { t } from '@i18n/index';

interface Props {
	locale?: 'es' | 'en';
}

const providedLocale = Astro.props.locale;
const locale = providedLocale ?? applyLocale(Astro);

// A GitHub outage must degrade the projects block, not 500 the whole page —
// so the fetch is guarded exactly like it is in /proyectos.
let repos: GitHubRepo[] = [];
let fetchError: string | null = null;

try {
	repos = await listRepos();
} catch (error) {
	fetchError = error instanceof Error ? error.message : 'Unknown error';
	repos = [];
}

const sortedRepos = sortRepos(repos);
const previews = await listPreviewNames();

// ContactSection gets no locale prop: its strings come from t(), which reads the
// module-level locale that applyLocale() already set for this request.
---

<AboutSection lang={locale} withJsonLd={true} />
<ValuePropositionSection locale={locale} />
<HabilitiesSection locale={locale} />
<ExperienceSection locale={locale} />
<ProjectsSection
	repos={sortedRepos}
	locale={locale}
	preview={4}
	error={fetchError}
	previews={previews}
/>

<ContactSection />
