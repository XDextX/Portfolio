---
import { LEVEL_COLOR, levelLabelMap, type TechLevel } from '../data/levelLabels';

export interface Props {
	name: string;
	logo: string;
	href?: string;
	level: TechLevel;
	locale?: 'es' | 'en';
}

const { name, logo, href, level, locale = 'es' } = Astro.props;
const color = LEVEL_COLOR[level];
const label = levelLabelMap[locale][level];
// A tech with no href renders a <span>, not <a href="#">: the latter is a
// focusable link whose only effect is jumping the page back to the top.
const Tag = href ? 'a' : 'span';
---

<Tag
	class='chip'
	{...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
	title={label}
	style={`--dot:${color}`}
>
	<img src={logo} alt='' width='18' height='18' loading='lazy' />
	{name}
	{/* The dot is aria-hidden, so without this the level reached assistive tech
	    only through a title attribute. */}
	<span class='sr-only'>{label}</span>
	<span class='chip-dot' aria-hidden='true' />
</Tag>

<style>
	/* A clickable element has to look like one. An earlier pass removed fill,
	   border and radius together and left it floating; the hover fill it used
	   (--neutral-100) measured 1.13:1 against the sheet. Hover moves colour, not
	   background: a fill alone lands near 1.2:1, so it goes to --accent-text. */
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.6rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		background: var(--tag-surface);
		color: var(--text-color);
		font-size: var(--fs-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			color var(--dur) var(--ease),
			border-color var(--dur) var(--ease);
	}

	.chip:hover {
		color: var(--accent-text);
		border-color: var(--accent-text);
		text-decoration: none;
	}

	.chip-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--dot);
		flex-shrink: 0;
	}
</style>
