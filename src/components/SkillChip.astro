---
import { LEVEL_COLOR, levelLabelMap, type TechLevel } from '../data/levelLabels';

export interface Props {
	name: string;
	logo: string;
	href?: string;
	level: TechLevel;
	locale?: 'es' | 'en';
}

const { name, logo, href, level, locale = 'es' } = Astro.props;
const color = LEVEL_COLOR[level];
const label = levelLabelMap[locale][level];
// A tech with no href renders a <span>, not <a href="#">: the latter is a
// focusable link whose only effect is jumping the page back to the top.
const Tag = href ? 'a' : 'span';
---

<Tag
	class='chip'
	{...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
	title={label}
	style={`--dot:${color}`}
>
	<img src={logo} alt='' width='18' height='18' loading='lazy' />
	{name}
	{/* The dot is aria-hidden, so without this the level reached assistive tech
	    only through a title attribute. */}
	<span class='sr-only'>{label}</span>
	<span class='chip-dot' aria-hidden='true' />
</Tag>

<style>
	/* It is a chip, not a row of text: this is a link to the technology's site,
	   and an element you can click has to look like one. An earlier pass here
	   removed the fill, the border and the radius together, which left logo and
	   label floating on the sheet with nothing to say "pressable" — and the
	   hover fill it used (--neutral-100) measured 1.13:1 against that sheet, so
	   it did not register either.

	   What changed is the radius and the weight, not the affordance: a lozenge at
	   999px on a 32px row is the generic look, --radius-sm is a chip. Weight 500
	   because ten rows at 600 is a wall, and the dot is 8px because it is now
	   the thing carrying the level.

	   Hover moves colour instead of background. A fill alone cannot work on a
	   near-white sheet — every light grey lands near 1.2:1 — so the text and the
	   border go to --accent-text, which is 5.2:1 here and 7.9:1 in the dark
	   theme, and it keeps navy and gold as the only chroma on the page. */
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.6rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		background: var(--tag-surface);
		color: var(--text-color);
		font-size: var(--fs-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			color var(--dur) var(--ease),
			border-color var(--dur) var(--ease);
	}

	.chip:hover {
		color: var(--accent-text);
		border-color: var(--accent-text);
		text-decoration: none;
	}

	.chip-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--dot);
		flex-shrink: 0;
	}
</style>
