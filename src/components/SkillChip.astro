---
import { LEVEL_COLOR, levelLabelMap, type TechLevel } from '../data/levelLabels';

export interface Props {
	name: string;
	logo: string;
	href?: string;
	level: TechLevel;
	locale?: 'es' | 'en';
}

const { name, logo, href, level, locale = 'es' } = Astro.props;
const color = LEVEL_COLOR[level];
const label = levelLabelMap[locale][level];
// A tech with no href renders a <span>, not <a href="#">: the latter is a
// focusable link whose only effect is jumping the page back to the top.
const Tag = href ? 'a' : 'span';
---

<Tag
	class='chip'
	{...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}
	title={label}
	style={`--dot:${color}`}
>
	<img src={logo} alt='' width='18' height='18' loading='lazy' />
	{name}
	<span class='chip-dot' aria-hidden='true' />
</Tag>

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.65rem 0.3rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--card-background);
		font-size: var(--fs-sm);
		font-weight: 600;
		color: var(--text-color);
		text-decoration: none;
		transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
	}

	.chip:hover {
		border-color: var(--dot);
		transform: translateY(-1px);
		text-decoration: none;
	}

	.chip-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--dot);
		flex-shrink: 0;
	}
</style>
