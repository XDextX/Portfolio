---
import ContactCard from './ContactCard.astro';
import { CONTACTS } from '../data/contacts';
import { t } from '@i18n/index';

const titleId = 'contact-title';
const title = t('contact.title');
const tagline = t('contact.tagline');

// No itemscope here on purpose. The canonical structured data for this person
// is the JSON-LD Person in AboutSection; a second Person via microdata on the
// same page read as two entities for one person. The name also used to be
// hardcoded in this template, duplicating ABOUT.name.
// Every string below comes from t(), so this component needs no locale prop.
---

<section
	aria-labelledby={titleId}
	id='Contact'
	class='section'
>
	<div class='contact-header'>
		<h2 id={titleId}>{title}</h2>
		<p class='tagline'>{tagline}</p>
	</div>

	<ul class='contact-list'>
		{
			CONTACTS.map((c) => (
				<li>
					<ContactCard item={c} />
				</li>
			))
		}
	</ul>
</section>

<style>
	.contact-header {
		margin-bottom: 1.75rem;
	}

	.tagline {
		margin: 0.4rem 0 0;
		color: var(--neutral-600);
		font-size: var(--fs-base);
	}

	.contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		/* Without a gap the wrapped cards shared an edge: measured as
		   `gap: normal` on the list, which is how EMAIL and GITHUB ended up
		   touching in the render. */
		gap: var(--sp-3);
		max-width: unset;
	}

	/* The list is a flex row, so each <li> is a flex item and its automatic
	   minimum size is its min-content width. The contact value is
	   white-space: nowrap so that it can ellipsize, which means its min-content
	   width is the whole address — the item then refuses to shrink and pushes
	   past the container. Measured: 84px of horizontal scroll at a 360px
	   viewport, 30px at 414px. Zeroing the minimum lets the card shrink and the
	   ellipsis finally do its job. */
	.contact-list > li {
		min-width: 0;
	}
</style>
