---
import ContactCard from './ContactCard.astro';
import ContactForm from './ContactForm.astro';
import { CONTACTS } from '../data/contacts';
import { t } from '@i18n/index';
import SectionTitle from './SectionTitle.astro';
import { SECTION_TITLES } from '../data/sectionTitles';

const titleId = SECTION_TITLES.contact.id;
const tagline = t('contact.tagline');

// No itemscope here on purpose. The canonical structured data for this person
// is the JSON-LD Person in AboutSection; a second Person via microdata on the
// same page read as two entities for one person. The name also used to be
// hardcoded in this template, duplicating ABOUT.name.
// Every string below comes from t(), so this component needs no locale prop.
---

<section
	aria-labelledby={titleId}
	id='Contact'
	class='section'
>
	<div class='contact-body'>
	<div class='contact-layout'>
	<div class='contact-main'>
	<div class='contact-header'>
		<SectionTitle section='contact' />
		<p class='tagline'>{tagline}</p>
	</div>

	<ul class='contact-list'>
		{
			CONTACTS.map((c) => (
				<li>
					<ContactCard item={c} />
				</li>
			))
		}
	</ul>
	</div>

	<ContactForm />
	</div>
	</div>
</section>

<style>
	.contact-header {
		margin-bottom: 1.75rem;
	}

	.tagline {
		margin: 0.4rem 0 0;
		color: var(--neutral-600);
		font-size: var(--fs-base);
	}

	/* Title, text and cards left, the form card right from the top, as the proposal draws
	   it (spec 029): with the title above both, the cards column ended far short of the form. */
	.contact-body {
		container: contact / inline-size;
	}

	.contact-layout {
		display: grid;
		gap: var(--sp-6);
	}

	@container contact (min-width: 60rem) {
		.contact-layout {
			grid-template-columns: 1fr minmax(20rem, 26rem);
			align-items: start;
		}
	}

	.contact-list {
		align-content: start;
		list-style: none;
		margin: 0;
		padding: 0;
		/* One card per row across the cards column (spec 029, owner): at half width, with
		   copy and open beside it, every value was cut at 1280px ("germonr…"). */
		display: grid;
		gap: var(--sp-3);
		max-width: unset;
	}

	/* Each <li> is a flex item whose automatic minimum is its min-content width,
	   and the nowrap value ellipsizes — so the minimum is the whole address and
	   the item refuses to shrink. Measured 84px of scroll at 360px, 30px at
	   414px. Zeroing it lets the card shrink and the ellipsis work. */
	.contact-list > li {
		min-width: 0;
	}
</style>
