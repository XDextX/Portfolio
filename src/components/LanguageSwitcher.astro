---
import { availableLocales, t } from '@i18n/index';
import { isSupportedLocale } from '@utils/locale';

export interface Props {
	locale: string;
}

const { locale } = Astro.props;
const locales = availableLocales().filter(isSupportedLocale);
const current = isSupportedLocale(locale) ? locale : 'es';
const hint = t('layout.languageSwitcher');
// The label wraps the select below, so the association needs no id at all: a
// global id here would collide as soon as a second instance exists.
---

<label class='language-switcher' title={hint}>
	<span class='label'>{t('layout.language')}</span>
	<select class='select' data-lang-switcher>
		{
			locales.map((code) => (
				<option value={code} selected={code === current}>
					{code.toUpperCase()}
				</option>
			))
		}
	</select>
</label>

<script>
	import { navigate } from 'astro:transitions/client';

	// Re-bound on every navigation: with <ClientRouter /> the DOM is replaced,
	// so a listener bound once would die on the first transition.
	document.addEventListener('astro:page-load', () => {
		document
			.querySelectorAll<HTMLSelectElement>('[data-lang-switcher]')
			.forEach((select) => {
				select.addEventListener('change', (event) => {
					const value = (event.target as HTMLSelectElement).value;
					const next = new URL(window.location.href);
					next.searchParams.set('lang', value);
					// navigate() instead of window.location.replace(): the router
					// swaps the page instead of reloading it, and the server writes
					// the lang cookie while rendering the new locale.
					navigate(next.toString());
				});
			});
	});
</script>

<style>
	.label {
		color: var(--text-color);
	}

	/*
	 * The label is the control's box.
	 *
	 * It used to be two unboxed things: the word "Idioma" and a select with its
	 * own border, so the chrome read as one loose control rather than a group.
	 * The label is also what associates the text with the select implicitly, so
	 * making the label the box keeps the association and needs no id — which
	 * matters, because a global id here would collide on a second instance.
	 *
	 * The select loses its own border and background so there is one frame
	 * instead of two nested ones. It keeps appearance:auto on purpose: the
	 * native control brings the platform's own dropdown affordance, and
	 * replacing that means reimplementing keyboard navigation, roles, Escape
	 * and the mobile picker.
	 */
	.language-switcher {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-sm);
		background: var(--card-background);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0 0.6rem;
		/* Must match .theme-btn exactly: the two controls sit in one row and a
		   sub-pixel difference reads as crooked. Both were measured at 29.00
		   and 29.59 before this, because each derived its height from a
		   different padding — 4px 12px against 4.8px 8px. An explicit height
		   with border-box (set globally in 01-base.css) stops padding from
		   adding to it.

		   A literal, not a token: two controls are not a design system, and a
		   --control-h would imply there is one. If a third control ever needs to
		   match, that is when the token starts meaning something. */
		block-size: 30px;
	}

	.select {
		background: transparent;
		color: var(--text-color);
		border: 0;
		padding: 0;
		cursor: pointer;
		/* 400 is the body weight, so the control reads as text with a border
		   rather than as a control. Everything else interactive on the site is
		   500 or 600. */
		font-weight: 500;
	}

	.select:hover {
		color: var(--accent-text);
	}
</style>
