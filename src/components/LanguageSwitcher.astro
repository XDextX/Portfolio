---
import { availableLocales, t } from '@i18n/index';
import { isSupportedLocale } from '@utils/locale';

export interface Props {
	locale: string;
}

const { locale } = Astro.props;
const locales = availableLocales().filter(isSupportedLocale);
const current = isSupportedLocale(locale) ? locale : 'es';
const hint = t('layout.languageSwitcher');
// The label wraps the select below, so the association needs no id at all: a
// global id here would collide as soon as a second instance exists.
---

<label class='language-switcher' title={hint}>
	<span class='label'>{t('layout.language')}</span>
	<select class='select' data-lang-switcher>
		{
			locales.map((code) => (
				<option value={code} selected={code === current}>
					{code.toUpperCase()}
				</option>
			))
		}
	</select>
</label>

<script>
	import { navigate } from 'astro:transitions/client';

	// Re-bound on every navigation: with <ClientRouter /> the DOM is replaced,
	// so a listener bound once would die on the first transition.
	document.addEventListener('astro:page-load', () => {
		document
			.querySelectorAll<HTMLSelectElement>('[data-lang-switcher]')
			.forEach((select) => {
				select.addEventListener('change', (event) => {
					const value = (event.target as HTMLSelectElement).value;
					const next = new URL(window.location.href);
					next.searchParams.set('lang', value);
					// navigate() instead of window.location.replace(): the router
					// swaps the page instead of reloading it, and the server writes
					// the lang cookie while rendering the new locale.
					navigate(next.toString());
				});
			});
	});
</script>

<style>
	.label {
		color: var(--text-color);
	}

	/*
	 * The label is the control's box, which also associates it implicitly — no
	 * id, and a global one collides on a second instance. The select keeps
	 * appearance:auto: the native control brings the platform affordance.
	 */
	.language-switcher {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-sm);
		background: var(--card-background);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0 0.6rem;
		/* Must match .theme-btn exactly: measured 29.00 and 29.59 before, each
		   deriving height from different padding. An explicit block-size plus
		   border-box (global, 01-base.css) stops padding adding to it. A literal,
		   not a token — two controls are not a design system. */
		block-size: 30px;
	}

	.select {
		background: transparent;
		color: var(--text-color);
		border: 0;
		padding: 0;
		cursor: pointer;
		/* 400 is the body weight, so the control reads as text with a border
		   rather than as a control. Everything else interactive on the site is
		   500 or 600. */
		font-weight: 500;
	}

	.select:hover {
		color: var(--accent-text);
	}
</style>
