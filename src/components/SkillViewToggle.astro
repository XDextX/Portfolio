---
// No props — renders the two view-toggle buttons; TechGrid owns the JS logic.
// Labels go through i18n so they follow the active locale, and each button
// carries an aria-label because `title` alone is a weak accessible name.
import { t } from '@i18n/index';
---

<div class='view-toggle' role='group' aria-label={t('skills.views.group')}>
	<button
		class='toggle-btn'
		data-view='bars'
		aria-pressed='true'
		aria-label={t('skills.views.bars')}
		title={t('skills.views.bars')}
	>
		<svg
			xmlns='http://www.w3.org/2000/svg'
			viewBox='0 0 24 24'
			fill='none'
			stroke='currentColor'
			stroke-width='2'
			stroke-linecap='round'
			stroke-linejoin='round'
			aria-hidden='true'
		>
			<line x1='18' y1='20' x2='18' y2='10'></line><line
				x1='12'
				y1='20'
				x2='12'
				y2='4'></line><line x1='6' y1='20' x2='6' y2='14'></line>
		</svg>
		<span class='toggle-indicator' aria-hidden='true'></span>
	</button>

	<button
		class='toggle-btn'
		data-view='list'
		aria-pressed='false'
		aria-label={t('skills.views.list')}
		title={t('skills.views.list')}
	>
		<svg
			xmlns='http://www.w3.org/2000/svg'
			viewBox='0 0 24 24'
			fill='none'
			stroke='currentColor'
			stroke-width='2'
			stroke-linecap='round'
			stroke-linejoin='round'
			aria-hidden='true'
		>
			<line x1='8' y1='6' x2='21' y2='6'></line><line
				x1='8'
				y1='12'
				x2='21'
				y2='12'></line><line x1='8' y1='18' x2='21' y2='18'></line><line
				x1='3'
				y1='6'
				x2='3.01'
				y2='6'></line><line x1='3' y1='12' x2='3.01' y2='12'></line><line
				x1='3'
				y1='18'
				x2='3.01'
				y2='18'></line>
		</svg>
		<span class='toggle-indicator' aria-hidden='true'></span>
	</button>
</div>

<style>
	/*
	 * The button's radius is the group's minus the group's own padding. It was
	 * calc(var(--radius-md) - 2px), and that 2px came from nowhere: the padding
	 * is 0.2rem, so the real inset is 3.2px.
	 */
	.view-toggle {
		display: flex;
		gap: 0.25rem;
		background: var(--card-background);
		border: 1px solid var(--control-border);
		border-radius: var(--radius-md);
		padding: 0.2rem;
		transition: border-color var(--dur) var(--ease);
	}

	/* The group's border turns gold on hover (spec 017); the active button is 012's. */
	.view-toggle:hover {
		border-color: var(--accent-text);
	}

	.toggle-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: calc(var(--radius-md) - 0.2rem);
		border: none;
		background: transparent;
		color: var(--neutral-600);
		cursor: pointer;
		transition:
			background var(--dur) var(--ease),
			color var(--dur) var(--ease);
	}

	.toggle-btn svg {
		inline-size: 1rem;
		block-size: 1rem;
	}

	.toggle-btn:hover {
		background: var(--neutral-200);
		color: var(--text-color);
	}

	/*
	 * Spec 012: the active state hangs on aria-pressed, which the server renders, so it
	 * shows with scripts off. The fill stays (--neutral-200, the soft fill inside the
	 * sheet); alone it was 1.37:1 in dark, so the gold bar is what tells the views apart.
	 */
	.toggle-btn[aria-pressed='true'] {
		background: var(--neutral-200);
		color: var(--accent-text);
	}

	/* Spec 048: 44 × 44 under a finger; the icon stays 1rem, the indicator stays under it. */
	@media (pointer: coarse) {
		.toggle-btn {
			width: 44px;
			height: 44px;
		}
	}

	/* Centred under the 1rem icon: inset by half the button less half the icon, so it holds at
	   2rem and at 44px. No transition, so reduced motion has nothing to drop. */
	.toggle-indicator {
		position: absolute;
		inset-inline: calc(50% - 0.5rem);
		inset-block-end: 0.2rem;
		block-size: 2px;
		background: var(--accent-text);
		visibility: hidden;
	}

	.toggle-btn[aria-pressed='true'] .toggle-indicator {
		visibility: visible;
	}
</style>
