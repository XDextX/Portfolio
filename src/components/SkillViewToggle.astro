---
// No props — renders the two view-toggle buttons; TechGrid owns the JS logic.
// Labels go through i18n so they follow the active locale, and each button
// carries an aria-label because `title` alone is a weak accessible name.
import { t } from '@i18n/index';
---

<div class='view-toggle' role='group' aria-label={t('skills.views.group')}>
	<button
		class='toggle-btn'
		data-view='bars'
		aria-pressed='true'
		aria-label={t('skills.views.bars')}
		title={t('skills.views.bars')}
	>
		<svg
			xmlns='http://www.w3.org/2000/svg'
			width='16'
			height='16'
			viewBox='0 0 24 24'
			fill='none'
			stroke='currentColor'
			stroke-width='2'
			stroke-linecap='round'
			stroke-linejoin='round'
			aria-hidden='true'
		>
			<line x1='18' y1='20' x2='18' y2='10'></line><line
				x1='12'
				y1='20'
				x2='12'
				y2='4'></line><line x1='6' y1='20' x2='6' y2='14'></line>
		</svg>
	</button>

	<button
		class='toggle-btn'
		data-view='list'
		aria-pressed='false'
		aria-label={t('skills.views.list')}
		title={t('skills.views.list')}
	>
		<svg
			xmlns='http://www.w3.org/2000/svg'
			width='16'
			height='16'
			viewBox='0 0 24 24'
			fill='none'
			stroke='currentColor'
			stroke-width='2'
			stroke-linecap='round'
			stroke-linejoin='round'
			aria-hidden='true'
		>
			<line x1='8' y1='6' x2='21' y2='6'></line><line
				x1='8'
				y1='12'
				x2='21'
				y2='12'></line><line x1='8' y1='18' x2='21' y2='18'></line><line
				x1='3'
				y1='6'
				x2='3.01'
				y2='6'></line><line x1='3' y1='12' x2='3.01' y2='12'></line><line
				x1='3'
				y1='18'
				x2='3.01'
				y2='18'></line>
		</svg>
	</button>
</div>

<style>
	/*
	 * The button's radius is the group's minus the group's own padding.
	 *
	 * It used to be calc(var(--radius-md) - 2px), and that 2px came from
	 * nowhere: the padding above is 0.2rem, so the real inset is 3.2px and the
	 * arithmetic should have said so. Change --radius-md and the hardcoded 2
	 * would have stayed behind, no longer meaning "the group less its inset".
	 * Writing it as the token minus 0.2rem keeps the relationship stated.
	 *
	 * A pill radius was the other option and the wrong one: at 32px square it
	 * rounds the corners nearly off and stops reading as a button.
	 */
	.view-toggle {
		display: flex;
		gap: 0.25rem;
		background: var(--card-background);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0.2rem;
	}

	.toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: calc(var(--radius-md) - 0.2rem);
		border: none;
		background: transparent;
		color: var(--neutral-600);
		cursor: pointer;
		transition:
			background var(--dur) var(--ease),
			color var(--dur) var(--ease);
	}

	.toggle-btn:hover {
		background: var(--neutral-200);
		color: var(--text-color);
	}

	/*
	 * --neutral-200, which is also --tag-surface in light: one colour for a
	 * soft fill inside the sheet, everywhere.
	 *
	 * It used to be var(--bg-color), and that token only existed in light.css —
	 * dark.css never defined it. So in dark the declaration fell through to the
	 * light value and the active button painted #E4E8EE, a near-white grey from
	 * the warm era, on top of the navy sheet. A token defined in one theme and
	 * read in both is worse than no token: nothing errors, and the fallback is
	 * another theme's palette. --neutral-100 was not an option either, because in
	 * dark it *is* --card-background and the selected button would vanish into
	 * the card.
	 */
	.toggle-btn.active {
		background: var(--neutral-200);
		color: var(--accent-text);
	}
</style>
