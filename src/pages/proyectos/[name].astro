---
import Chip from '@components/Chip.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/BreadCrumbs.astro';
import { t } from '@i18n/index';
import Readme from '@components/Readme.astro';
import type { GitHubRepo } from '@type/github';
import { applyLocale } from '@utils/locale';
import { getRepo } from '@lib/github';
import { CANONICAL_ORIGIN } from '../../data/site';
import { projectDescription, projectEntity } from '@utils/seo';
import LanguageBadge from '@components/LanguageBadge.astro';
import PageHeader from '@components/PageHeader.astro';

const { name } = Astro.params;
const locale = applyLocale(Astro);

// Spec 021: a missing project is a 404 at its own URL; anything else that fails is a 503, never
// "this project does not exist".
let repo: GitHubRepo | null = null;
try {
	repo = await getRepo(name!);
	// The query carries ?lang=; a bare '/404' rendered the not-found page in Spanish for English.
	if (repo === null) return Astro.rewrite(`/404${Astro.url.search}`);
} catch {
	// GitHub failed: the unavailable state below
}
if (!repo) Astro.response.status = 503;

const view = repo && (() => {
	const intlLocale = locale === 'es' ? 'es-CR' : 'en-US';
	const title = `${repo.name} - ${t('projects.title')}`;
	// One resolution, three readers: the paragraph below, the layout's description
	// and the entity. `lang` stays out of the entity — its `N/A` is a badge label,
	// not a language (RF-7).
	const desc = projectDescription(repo, t('project.meta.noDescription'));
	const lang = repo.language ?? 'N/A';
	const hasDemo = !!repo.homepage && String(repo.homepage).trim() !== '';
	const topics: string[] = Array.isArray(repo.topics) ? repo.topics : [];
	const updated = new Date(repo.updated_at);
	const fmtDate = new Intl.DateTimeFormat(intlLocale, { dateStyle: 'medium' });
	const fmtNum = new Intl.NumberFormat(intlLocale);
	const starsLabel = t('project.meta.starsLabel', {
		count: fmtNum.format(repo.stargazers_count),
	});
	const forksLabel = t('project.meta.forksLabel', {
		count: fmtNum.format(repo.forks_count),
	});

	const directions = [
		{ label: t('nav.home'), href: '/' },
		{ label: t('nav.projects'), href: '/proyectos' },
		{ label: repo.name, href: `/proyectos/${repo.name}` },
	];

	const jsonLd = projectEntity({
		repo,
		url: `${CANONICAL_ORIGIN}/proyectos/${repo.name}`,
		description: desc,
	});
	return { title, desc, lang, hasDemo, topics, updated, fmtDate, starsLabel, forksLabel, directions, jsonLd };
})();
const { title, desc, lang, hasDemo, topics, updated, fmtDate, starsLabel, forksLabel, directions, jsonLd } =
	view ?? ({} as Record<string, never>);
---

{
	repo ? (
<BaseLayout title={title} description={desc} jsonLd={jsonLd} locale={locale}>
	<section class='wrap project-page'>
		<PageHeader lead={desc}>
			<Fragment slot='before'>
				<Breadcrumbs directions={directions} />
				<a class='btn btn--ghost back-btn' href='/proyectos'>
					<span aria-hidden='true'>←</span>
					{t('nav.back')}
				</a>
			</Fragment>
			<div slot='title' class='project-page__heading'>
				<h1 id='project-title' class='title' transition:name=`p-${repo.id}-title`>
					{repo.name}
				</h1>
				<p class='stack' transition:name={`p-${repo.id}-lang`}>
					<LanguageBadge lang={lang} />
				</p>
			</div>
		</PageHeader>

		<section class='grid section'>
			<aside class='card sidebar' aria-label={t('project.actions.section')}>
				<div class='updated flex items-center gap-2'>
					<span class='dot' aria-hidden='true'></span>
					<span>
						<time datetime={updated.toISOString()}>
							{t('project.meta.updated', { date: fmtDate.format(updated) })}
						</time>
					</span>
				</div>

				<div
					class='flex gap-4 items-center mt-2'
					aria-label={t('project.meta.metrics')}
				>
					<span title={starsLabel}>{starsLabel}</span>
					<span title={forksLabel}>{forksLabel}</span>
				</div>

				{
					topics.length ? (
						<div class='topics' role='group' aria-label={t('project.meta.tags')}>
							{topics.map((tag) => (
								<Chip text={tag} />
							))}
						</div>
					) : null
				}

				<nav class='actions' aria-label={t('project.actions.section')}>
					<a
						class='btn btn--ghost'
						href={repo.html_url}
						target='_blank'
						rel='noopener'
					>
						{t('project.actions.code')}
					</a>
					{
						hasDemo ? (
							<a
								class='btn btn--primary'
								href={repo.homepage}
								target='_blank'
								rel='noopener'
							>
								{t('project.actions.liveDemo')}
							</a>
						) : (
							<span class='btn btn--disabled' aria-disabled='true'>
								{t('project.actions.noDemo')}
							</span>
						)
					}
				</nav>
			</aside>

			<section class='readme' aria-label={t('project.readme.label')}>
				<Readme repo={repo} />
			</section>
		</section>
	</section>
</BaseLayout>
	) : (
		<BaseLayout
			title={`${t('project.unavailable.title')} - Portfolio`}
			description={t('project.unavailable.message')}
			locale={locale}
		>
			<section class='wrap project-page'>
				<PageHeader lead={t('project.unavailable.message')}>
					<a slot='before' class='btn btn--ghost back-btn' href='/proyectos'>
						<span aria-hidden='true'>←</span>
						{t('nav.back')}
					</a>
					<h1 slot='title' class='title'>{t('project.unavailable.title')}</h1>
				</PageHeader>
			</section>
		</BaseLayout>
	)
}

<style>
	.back-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		align-self: flex-start;
		font-size: var(--fs-sm);
	}

	.project-page {
		display: grid;
		gap: 1.25rem;
	}

	/* The badge wraps under a long name; the name wraps before the tile shrinks. */
	.project-page__heading {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		min-inline-size: 0;
	}

	.project-page__heading h1 {
		margin: 0;
		min-inline-size: 0;
		overflow-wrap: anywhere;
	}

	.grid {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 1rem;
		align-items: start;
		min-height: 60vh;
	}

	.sidebar {
		position: sticky;
		top: 1rem;
	}

	.readme {
		overflow: auto;
		max-height: calc(70vh - 2rem);
		padding-right: 0.25rem;
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: hsl(220 30% 60%);
		display: inline-block;
	}

	.updated {
		white-space: nowrap;
	}

	.topics {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 0.9rem;
	}

	.actions {
		display: flex;
		gap: 0.6rem;
		margin-top: 1rem;
		flex-wrap: wrap;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.sidebar {
			position: static;
		}
		.readme {
			max-height: none;
		}
	}
</style>
