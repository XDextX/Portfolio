---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/BreadCrumbs.astro';
import ProjectsSection from '@components/ProjectsSection.astro';
import PageHeader from '@components/PageHeader.astro';
import ProjectFilters from '@components/ProjectFilters.astro';
import { t, tWords } from '@i18n/index';
import { SECTION_TITLES } from '../../data/sectionTitles';
import type { GitHubRepo } from '@type/github';
import { applyLocale } from '@utils/locale';
import { listRepos, listPreviewNames, sortRepos, parseCategory, inCategory } from '@lib/github';

const locale = applyLocale(Astro);
const topic = (import.meta.env.GITHUB_TOPIC ?? '').trim();

let repos: GitHubRepo[] = [];
let fetchError: string | null = null;

try {
	const items = await listRepos();

	const filtered = topic
		? items.filter(
				(repo) => Array.isArray(repo.topics) && repo.topics.includes(topic),
			)
		: items;

	// Same ranking as the home page, so a repo never moves between routes.
	repos = sortRepos(filtered);
} catch (error) {
	fetchError = error instanceof Error ? error.message : 'Unknown error';
	repos = [];
}

// Spec 040: an unknown `cat` parses to null, which renders every repository.
const cat = parseCategory(Astro.url.searchParams.get('cat'));
const shown = cat ? repos.filter((repo) => inCategory(repo, cat)) : repos;

const previews = await listPreviewNames();

// The gold word renders on one markup line: template whitespace would change the h1's name.
const words = tWords('projects.title');

const pageTitle = `${t('projects.title')} - Portfolio`;
const pageDescription = topic
	? t('projects.description.withTopic', { topic })
	: t('projects.description.default');
const directions = [
	{ label: t('nav.home'), href: '/' },
	{ label: t('nav.projects'), href: '/proyectos' },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: t('projects.title'),
	description: pageDescription,
	url: Astro.url.href,
	numberOfItems: repos.length,
	about: topic
		? `GitHub repositories tagged with ${topic}`
		: 'GitHub repositories',
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	jsonLd={jsonLd}
	locale={locale}
>
	<section class='wrap projects-page'>
		<PageHeader lead={t('projects.lead')}>
			<Breadcrumbs slot='before' directions={directions} />
			<h1 slot='title' transition:name={SECTION_TITLES.projects.transitionName} class='projects-page__title'>{words.map((w, i) => <>{i > 0 && ' '}{w.gold ? <span class='projects-page__word'>{w.text}</span> : w.text}</>)}</h1>
			{
				topic && (
					<p class='projects-page__topic'>
						{t('projects.topicLabel')}: <code>{topic}</code>
					</p>
				)
			}
			<ProjectFilters current={cat} />
		</PageHeader>

		{
			fetchError ? (
				<p role='alert' class='projects-page__error'>
					{t('projects.error', { detail: fetchError })}
				</p>
			) : (
				<ProjectsSection
					repos={shown}
						emptyKey={cat ? 'projects.empty.category' : undefined}
					title={t('projects.title')}
					hideTitle={true}
					locale={locale}
					previews={previews}
				/>
			)
		}
	</section>

	<style>
		.projects-page {
			display: grid;
			gap: 1.25rem;
		}

		.projects-page__title {
			margin: 0;
			color: var(--text-color);
		}

		.projects-page__word {
			color: var(--accent-text);
		}

		.projects-page__topic code {
			background: var(--card-background);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-sm);
			padding: 0.1rem 0.45rem;
			font-family: var(--font-mono);
		}

		.projects-page__error {
			color: var(--danger-color);
		}
	</style>
</BaseLayout>
