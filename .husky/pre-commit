#!/usr/bin/env sh
# Se ejecuta antes de cada commit. Si algo falla, el commit se cancela.
#
# Solo valida lo que hoy funciona de verdad en el repo:
#   - test:  `npm test` (vitest)                     [funciona]
#   - build: `npm run build` (astro)                 [funciona]
#
# NO se invoca `npm run lint` / `npm run format`: eslint y prettier no estan
# instalados y no hay config, asi que fallarian siempre. Cuando se agreguen,
# anadelos aqui.
#
# Bypass temporal:  git commit --no-verify

npm test

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests fallaron — commit cancelado."
  echo "   Si es intencional: git commit --no-verify"
  exit 1
fi

echo "✅ tests ok"
