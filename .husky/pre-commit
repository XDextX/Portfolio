#!/usr/bin/env sh
# Runs before every commit; any failure cancels it (constitution 7).
#   - npm test           vitest, data and source guards
#   - npm run test:e2e   Playwright on the installed Chrome, rendered checks
# lint and format are not run: neither eslint nor prettier is installed.
# Bypass, only when intentional:  git commit --no-verify

npm test
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ npm test failed — commit cancelled."
  echo "   If intentional: git commit --no-verify"
  exit 1
fi

npm run test:e2e
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ npm run test:e2e failed — commit cancelled."
  echo "   If intentional: git commit --no-verify"
  exit 1
fi

echo "✅ tests ok"
